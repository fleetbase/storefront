<div class="storefront-panel-sections" data-test-customer-places>
    {{#if this.rows.length}}
        <div class="storefront-panel-sections__toolbar">
            <span class="storefront-panel-sections__lede">{{t "storefront.customers.card.places-count" count=this.rows.length}}</span>
            <Button @size="xs" @icon="plus" @text={{t "storefront.customers.addresses.add"}} @onClick={{this.addAddress}} @permission="fleet-ops create place" class="ml-auto" data-test-customer-add-address />
        </div>
        <div class="storefront-member-list">
            {{#each this.rows as |row|}}
                <div class="storefront-member-row" data-test-customer-place={{row.place.id}}>
                    <Place::Pill @place={{row.place}} @size="xs" @subtitle={{null}} />
                    <div class="storefront-member-row__identity">
                        <div class="storefront-member-row__meta">{{n-a row.place.address}}</div>
                    </div>
                    {{#if row.isDefault}}
                        <Badge @status="info" @size="xs" @hideStatusDot={{true}} @text={{t "storefront.customers.panel.default"}} />
                    {{else}}
                        <Button @size="xs" @icon="star" @text={{t "storefront.customers.panel.set-default"}} @onClick={{perform this.setDefault row.place}} @isLoading={{this.setDefault.isRunning}} @permission="storefront update customer" />
                    {{/if}}
                </div>
            {{/each}}
        </div>
    {{else}}
        <div class="storefront-panel-empty" data-test-customer-places-empty>
            <span class="storefront-panel-empty__icon"><FaIcon @icon="map-marker-alt" /></span>
            <div class="storefront-panel-empty__title">{{t "storefront.customers.panel.no-places"}}</div>
            <div class="storefront-panel-empty__help">{{t "storefront.customers.panel.no-places-help"}}</div>
            <Button @type="primary" @size="sm" @icon="plus" @text={{t "storefront.customers.addresses.add"}} @onClick={{this.addAddress}} @permission="fleet-ops create place" data-test-customer-add-address />
        </div>
    {{/if}}
</div>
