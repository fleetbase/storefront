<div class="storefront-panel-sections" data-test-customer-orders>
    <div class="storefront-panel-sections__toolbar">
        <Input class="form-input form-input-sm w-64" placeholder={{t "storefront.orders.index.search"}} aria-label={{t "storefront.orders.index.search"}} {{on "input" this.search}} />
        {{#if this.loadOrders.isRunning}}<Spinner />{{/if}}
    </div>
    {{#if this.orders.length}}
        <table class="storefront-panel-table">
            <thead>
                <tr>
                    <th>{{t "storefront.component.widget.orders.id-column"}}</th>
                    <th>{{t "storefront.networks.orders.columns.placed"}}</th>
                    <th>{{t "storefront.networks.orders.columns.fulfillment"}}</th>
                    <th>{{t "storefront.common.status"}}</th>
                    <th class="is-right">{{t "storefront.networks.orders.columns.total"}}</th>
                    <th class="storefront-panel-table__actions"><span class="sr-only">{{t "storefront.common.actions"}}</span></th>
                </tr>
            </thead>
            <tbody>
                {{#each this.orders as |order|}}
                    <tr class="storefront-panel-table__row" data-test-customer-orders-row={{order.public_id}}>
                        <td><a href="javascript:;" class="storefront-table__link" {{on "click" (fn this.viewOrder order)}}>{{order.public_id}}</a></td>
                        <td class="is-muted">{{order.createdAgo}}</td>
                        <td><Badge @status={{if order.meta.is_pickup "info" "delivery"}} @hideStatusDot={{true}} @size="xs" @text={{if order.meta.is_pickup (t "storefront.common.pickup") (t "storefront.networks.orders.delivery")}} /></td>
                        <td><Badge @status={{order.status}} @size="xs" /></td>
                        <td class="is-right">{{format-currency (or order.meta.total order.transaction_amount 0) order.meta.currency}}</td>
                        <td class="storefront-panel-table__actions"><Storefront::Order::Actions @order={{order}} @onChange={{this.handleOrderChange}} @asMenu={{true}} @renderInPlace={{false}} /></td>
                    </tr>
                {{/each}}
            </tbody>
        </table>
    {{else if this.loadOrders.isRunning}}
        <div class="storefront-panel-sections__pad"><Skeleton::Table @rows={{5}} @columns={{5}} @identityColumn={{false}} /></div>
    {{else}}
        <div class="storefront-panel-sections__empty">{{t "storefront.customers.panel.no-orders"}}</div>
    {{/if}}
</div>
