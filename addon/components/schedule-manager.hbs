{{! A week of opening hours: one row per day, its time slots as removable chips, and Add hours. }}
<div class="storefront-schedule" data-test-schedule-manager ...attributes>
    {{#if (and @emptyText (not this.hasHours))}}
        <p class="storefront-schedule__empty">{{@emptyText}}</p>
    {{/if}}
    <div class="storefront-schedule__week">
        {{#each this.days as |day|}}
            <div class="storefront-schedule__day {{if day.hours.length 'has-hours'}}" data-test-schedule-day={{day.name}}>
                <div class="storefront-schedule__name">{{day.label}}</div>
                <div class="storefront-schedule__slots">
                    {{#each day.hours as |hour|}}
                        <span class="storefront-schedule__slot">
                            {{hour.humanReadableHours}}
                            {{#unless @disabled}}
                                <button type="button" class="storefront-schedule__remove" aria-label={{t "common.remove"}} {{on "click" (fn this.removeHours hour)}}>
                                    <FaIcon @icon="times" @size="xs" />
                                </button>
                            {{/unless}}
                        </span>
                    {{else}}
                        <span class="storefront-schedule__none">{{or @noHoursText (t "storefront.component.schedule-manager.no-hours")}}</span>
                    {{/each}}
                </div>
                {{#unless @disabled}}
                    <button type="button" class="storefront-schedule__add" {{on "click" (fn this.addHours @subject day.name)}} data-test-schedule-add={{day.name}}>
                        <FaIcon @icon="plus" @size="xs" />
                        {{t "storefront.component.schedule-manager.add-hours"}}
                    </button>
                {{/unless}}
            </div>
        {{/each}}
    </div>
</div>
