<Layout::Resource::Card class="storefront-card storefront-customer-card" data-test-storefront-customer-card ...attributes as |Card|>
    <Card.header class={{@headerClass}}>
        <RegistryYield @registry="storefront:component:customer:card:header:start" as |RegistryComponent|>
            <RegistryComponent @customer={{this.customer}} @resource={{this.customer}} />
        </RegistryYield>
        <Customer::Pill @customer={{this.customer}} @onClick={{if @onView (fn @onView this.customer)}} class="storefront-card__identity" />
        <div class="storefront-card__subtitle">{{t "storefront.common.customer"}} · <ClickToCopy @value={{this.customer.public_id}}>{{this.customer.public_id}}</ClickToCopy></div>
        <RegistryYield @registry="storefront:component:customer:card:header:end" as |RegistryComponent|>
            <RegistryComponent @customer={{this.customer}} @resource={{this.customer}} />
        </RegistryYield>
    </Card.header>
    <Card.body class="storefront-card__body {{@bodyClass}}">
        <div class="storefront-card__facts" data-test-customer-facts>
            <div class="storefront-card__fact"><FaIcon @icon="envelope" @size="xs" class="mr-2" />{{#if this.customer.email}}<a href="mailto:{{this.customer.email}}">{{this.customer.email}}</a>{{else}}{{n-a null}}{{/if}}</div>
            <div class="storefront-card__fact"><FaIcon @icon="phone" @size="xs" class="mr-2" />{{#if this.customer.phone}}<a href="tel:{{this.customer.phone}}">{{this.customer.phone}}</a>{{else}}{{n-a null}}{{/if}}</div>
            {{#if this.placesCount}}
                <div class="storefront-card__fact"><FaIcon @icon="map-marker-alt" @size="xs" class="mr-2" />{{t "storefront.customers.card.places-count" count=this.placesCount}}</div>
            {{/if}}
        </div>
    </Card.body>
    <Card.footer class={{@footerClass}}>
        <RegistryYield @registry="storefront:component:customer:card:footer:start" as |RegistryComponent|>
            <RegistryComponent @customer={{this.customer}} @resource={{this.customer}} />
        </RegistryYield>
        <div class="storefront-card__actions">
            <Badge @status={{if this.customer.user_uuid "info" "default"}} @hideStatusDot={{true}} @size="xs" @text={{if this.customer.user_uuid (t "storefront.customers.card.account") (t "storefront.customers.panel.guest")}} />
            <div class="storefront-card__buttons">
                {{#if @onView}}
                    <Button @icon="eye" @size="xs" @helpText={{t "storefront.customers.index.view-customer-details"}} @onClick={{fn @onView this.customer}} data-test-customer-view />
                {{/if}}
                {{#if @onNewOrder}}
                    <Button @icon="plus" @size="xs" @helpText={{t "storefront.customers.panel.new-order"}} @onClick={{fn @onNewOrder this.customer}} @permission="storefront create order" data-test-customer-new-order />
                {{/if}}
            </div>
        </div>
        <div class="storefront-card__meta">
            <span>{{t "storefront.customers.card.since" date=this.customer.createdAtShort}}</span>
        </div>
        <RegistryYield @registry="storefront:component:customer:card:footer:end" as |RegistryComponent|>
            <RegistryComponent @customer={{this.customer}} @resource={{this.customer}} />
        </RegistryYield>
    </Card.footer>
</Layout::Resource::Card>
