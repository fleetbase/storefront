{{#if @items.length}}
    <div class="storefront-sidebar-group {{@wrapperClass}}" data-test-sidebar-group={{@id}} ...attributes>
        <div class="storefront-sidebar-group__head">{{@heading}}</div>
        {{#each @items as |item|}}
            <button type="button" class="storefront-sidebar-group__item" title={{item.name}} {{on "click" (fn @onSelect item)}} data-test-sidebar-group-item={{item.id}}>
                <span class="storefront-sidebar-group__icon"><FaIcon @icon={{or item.icon "store"}} @size="xs" /></span>
                <span class="storefront-sidebar-group__name">{{item.name}}</span>
                {{#if item.meta}}<span class="storefront-sidebar-group__meta">{{item.meta}}</span>{{/if}}
                <FaIcon @icon="arrow-right" @size="xs" class="storefront-sidebar-group__arrow" />
            </button>
        {{/each}}
    </div>
{{/if}}
