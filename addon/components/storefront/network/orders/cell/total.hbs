{{! One line for an order (its tip on hover); a checkout adds one line on how its tip splits. }}
<div class="storefront-order-total" title={{this.tipText}} data-test-order-total>
    <span class="storefront-order-total__amount">{{format-currency this.total this.currency}}</span>
    {{#if (and @row.isGroup this.tipText)}}
        <span class="storefront-order-total__tip">{{this.tipText}}</span>
    {{/if}}
</div>
