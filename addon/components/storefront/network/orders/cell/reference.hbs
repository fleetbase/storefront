<div class="storefront-order-ref {{if @row.isChild 'is-child'}}" data-test-order-reference>
    {{#if @row.isGroup}}
        <button type="button" class="storefront-order-ref__toggle" aria-expanded={{if @row.expanded "true" "false"}} aria-label={{t "storefront.networks.orders.expand-hint"}} {{on "click" (fn @column.onToggle @row)}} data-test-order-group-toggle>
            <FaIcon @icon={{if @row.expanded "chevron-down" "chevron-right"}} @size="xs" />
        </button>
        <span class="storefront-order-ref__text">
            <a href="javascript:;" class="storefront-order-ref__id storefront-order-ref__id--link" {{on "click" (fn @column.onToggle @row)}}>{{@row.id}}</a>
            <span class="storefront-order-ref__meta">{{t "storefront.networks.orders.group-summary" orders=@row.orderCount items=@row.itemCount}}</span>
        </span>
    {{else}}
        {{#if @row.isChild}}<span class="storefront-order-ref__branch" aria-hidden="true"></span>{{/if}}
        <span class="storefront-order-ref__text">
            <a href="javascript:;" class="storefront-order-ref__id storefront-order-ref__id--link" {{on "click" (fn @column.onView @row)}}>{{@row.public_id}}</a>
            <span class="storefront-order-ref__meta">
                {{t "storefront.networks.orders.items-count" count=(or @row.payload.entities_count @row.item_count 0)}}
            </span>
        </span>
    {{/if}}
</div>
