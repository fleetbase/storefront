<div class="storefront-identity-stack {{if this.isStack 'storefront-identity-stack--avatars'}}" data-test-order-stores>
    {{#each this.visible as |entry|}}
        {{#if entry.store}}
            {{#if this.isStack}}
                {{! A checkout across stores: one round logo per store, the name and summary on hover. }}
                <Resource::Pill
                    @resourceType="store"
                    @resource={{entry.store}}
                    @size="xs"
                    @class="storefront-identity-stack__avatar"
                    @contentWrapperClass="sr-only"
                    @showOnlineIndicator={{false}}
                    @popoverPlacement="top"
                    aria-label={{entry.name}}
                    data-test-order-store-avatar
                >
                    <span class="sr-only">{{entry.name}}</span>
                </Resource::Pill>
            {{else}}
                <Resource::Pill @resourceType="store" @resource={{entry.store}} @subtitle={{null}} @size="xs" @class="storefront-identity-stack__pill" />
            {{/if}}
        {{else if this.isStack}}
            <span class="storefront-identity-stack__initial" title={{entry.name}} aria-label={{entry.name}}>{{entry.initial}}</span>
        {{else}}
            <span class="storefront-identity-stack__text" title={{entry.name}}>{{entry.name}}</span>
        {{/if}}
    {{else}}
        <span class="text-gray-400">{{t "storefront.networks.orders.no-store"}}</span>
    {{/each}}
    {{#if this.overflow}}
        <span class="storefront-identity-stack__overflow" title={{this.overflowTitle}}>+{{this.overflow}}</span>
    {{/if}}
</div>
