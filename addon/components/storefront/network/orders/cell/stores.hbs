<div class="storefront-identity-stack {{if this.isStack 'storefront-identity-stack--tiles'}}" data-test-order-stores>
    {{#each this.visible as |entry|}}
        {{#if entry.store}}
            {{#if this.isStack}}
                {{! A checkout group: one tile per store, names on hover, so the row stays one line. }}
                <Resource::Pill @resourceType="store" @resource={{entry.store}} @size="xs" @class="storefront-identity-stack__pill" title={{entry.name}}><span class="sr-only">{{entry.name}}</span></Resource::Pill>
            {{else}}
                <Resource::Pill @resourceType="store" @resource={{entry.store}} @size="xs" @class="storefront-identity-stack__pill" />
            {{/if}}
        {{else}}
            <span class="storefront-identity-stack__text" title={{entry.name}}>{{entry.name}}</span>
        {{/if}}
    {{else}}
        <span class="text-gray-400">{{t "storefront.networks.orders.no-store"}}</span>
    {{/each}}
    {{#if this.overflow}}
        <span class="storefront-identity-stack__overflow" title={{this.overflowTitle}}>+{{this.overflow}}</span>
    {{/if}}
</div>
