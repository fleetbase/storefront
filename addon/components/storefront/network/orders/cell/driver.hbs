<div class="storefront-order-driver" data-test-order-driver>
    {{#if this.driver}}
        {{! The identity cell: photo and name on one line; a shared driver says so on hover. }}
        <Table::Cell::Identity
            @row={{this.driver}}
            @column={{hash resourceType="driver" hideBadges=true wrapperClass="min-w-0 max-w-full"}}
            title={{if (and @row.isGroup (gt @row.orderCount 1)) (t "storefront.networks.orders.driver-shared" count=@row.orderCount)}}
            data-test-order-driver-identity
        />
    {{else if this.isPickup}}
        <span class="storefront-order-driver__muted">{{t "storefront.networks.orders.no-driver-needed"}}</span>
    {{else if (gt this.driverCount 1)}}
        <span class="storefront-order-driver__muted">{{t "storefront.networks.orders.drivers-count" count=this.driverCount}}</span>
    {{else if this.canAssign}}
        <Button @size="xs" @icon="id-card" @text={{t "storefront.networks.orders.assign-driver"}} @onClick={{fn @column.onAssign @row}} @permission="storefront update order" />
    {{else}}
        <span class="storefront-order-driver__muted">{{t "storefront.networks.orders.unassigned"}}</span>
    {{/if}}
</div>
