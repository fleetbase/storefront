<ContentPanel @title={{t "storefront.common.store"}} @open={{true}} @isLoading={{or @isLoading this.isLoadingStorefront}} @actionButtons={{@actionButtons}} @wrapperClass="bordered-top" ...attributes>
    <div class="storefront-order-store" data-test-order-store>
        <Store::Pill @store={{this.storefrontRecord}} @title={{this.storeName}} @subtitle={{this.storeSubtitle}} @showOnlineIndicator={{true}} @static={{not this.storefrontRecord.id}} data-test-order-store-pill />
        <dl class="storefront-order-store__facts">
            <div class="storefront-order-store__row">
                <dt class="storefront-order-store__row-label">{{t "storefront.common.phone"}}</dt>
                <dd class="storefront-order-store__row-value">{{#if this.storePhone}}<a href="tel:{{this.storePhone}}">{{this.storePhone}}</a>{{else}}{{n-a null}}{{/if}}</dd>
            </div>
            <div class="storefront-order-store__row">
                <dt class="storefront-order-store__row-label">{{t "storefront.common.email"}}</dt>
                <dd class="storefront-order-store__row-value">{{#if this.storeEmail}}<a href="mailto:{{this.storeEmail}}">{{this.storeEmail}}</a>{{else}}{{n-a null}}{{/if}}</dd>
            </div>
            <div class="storefront-order-store__row">
                <dt class="storefront-order-store__row-label">{{t "storefront.common.website"}}</dt>
                <dd class="storefront-order-store__row-value">{{#if this.storeWebsite}}<a href={{this.storeWebsite}} target="_blank" rel="noopener noreferrer">{{this.storeWebsite}}</a>{{else}}{{n-a null}}{{/if}}</dd>
            </div>
            <div class="storefront-order-store__row">
                <dt class="storefront-order-store__row-label">{{t "storefront.common.address"}}</dt>
                <dd class="storefront-order-store__row-value storefront-order-store__address">
                    {{#if @resource.payload.pickup}}
                        <Place::Pill @place={{@resource.payload.pickup}} @size="xs" @static={{not @resource.payload.pickup.id}} />
                    {{else}}
                        {{n-a null}}
                    {{/if}}
                </dd>
            </div>
        </dl>
    </div>
    <div {{did-insert this.setupComponent}} {{did-update this.setupComponent this.storefrontId}}></div>
</ContentPanel>
