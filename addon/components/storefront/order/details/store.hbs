<ContentPanel @title={{t "storefront.common.store"}} @open={{true}} @isLoading={{or @isLoading this.isLoadingStorefront}} @actionButtons={{@actionButtons}} @wrapperClass="bordered-top" ...attributes>
    <div class="storefront-store-profile" data-test-order-store>
        <div class="storefront-store-profile__banner" {{background-url this.storefrontDisplay.backdrop_url}}></div>
        <div class="storefront-store-profile__identity">
            <Image src={{this.storeLogoUrl}} @fallbackSrc={{config "defaultValues.placeholderImage"}} alt={{this.storeName}} class="storefront-store-profile__logo" />
            <div class="storefront-store-profile__name">
                <div class="storefront-store-profile__title" data-test-order-store-name>{{this.storeName}}</div>
                <div class="storefront-store-profile__subtitle">
                    {{#if this.storefrontRecord}}
                        <span class="storefront-store-profile__dot {{if this.storefrontRecord.online 'is-online'}}"></span>
                        <span>{{if this.storefrontRecord.online (t "storefront.common.online") (t "storefront.common.offline")}}</span>
                    {{/if}}
                    {{#if this.storeSubtitle}}
                        {{#if this.storefrontRecord}}<span>·</span>{{/if}}
                        <span>{{this.storeSubtitle}}</span>
                    {{/if}}
                </div>
            </div>
        </div>
        <dl class="storefront-store-profile__facts">
            <div class="storefront-store-profile__fact">
                <dt>{{t "storefront.common.phone"}}</dt>
                <dd>{{#if this.storePhone}}<a href="tel:{{this.storePhone}}">{{this.storePhone}}</a>{{else}}{{n-a null}}{{/if}}</dd>
            </div>
            <div class="storefront-store-profile__fact">
                <dt>{{t "storefront.common.email"}}</dt>
                <dd>{{#if this.storeEmail}}<a href="mailto:{{this.storeEmail}}">{{this.storeEmail}}</a>{{else}}{{n-a null}}{{/if}}</dd>
            </div>
            <div class="storefront-store-profile__fact">
                <dt>{{t "storefront.common.website"}}</dt>
                <dd>{{#if this.storeWebsite}}<a href={{this.storeWebsite}} target="_blank" rel="noopener noreferrer">{{this.storeWebsite}}</a>{{else}}{{n-a null}}{{/if}}</dd>
            </div>
            <div class="storefront-store-profile__fact">
                <dt>{{t "storefront.common.currency"}}</dt>
                <dd>{{n-a this.storefrontRecord.currency}}</dd>
            </div>
            <div class="storefront-store-profile__fact is-wide">
                <dt>{{if @resource.meta.is_pickup (t "storefront.orders.create.pickup-from") (t "storefront.orders.create.leaves-from")}}</dt>
                <dd>{{n-a this.pickupAddress}}</dd>
            </div>
        </dl>
    </div>
    <div {{did-insert this.setupComponent}} {{did-update this.setupComponent this.storefrontId}}></div>
</ContentPanel>
