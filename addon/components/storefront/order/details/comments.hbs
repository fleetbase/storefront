<ContentPanel
    @title={{t "storefront.order.sections.comments"}}
    @open={{not @folded}}
    @isLoading={{@isLoading}}
    @actionButtons={{@actionButtons}}
    @wrapperClass="bordered-top"
    ...attributes
>
    <CommentThread @subject={{@resource}} @subjectType="storefront:order" />
</ContentPanel>
