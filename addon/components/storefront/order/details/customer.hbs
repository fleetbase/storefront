<ContentPanel @title="Customer" @open={{true}} @isLoading={{@isLoading}} @wrapperClass="bordered-top" ...attributes>
    <div class="storefront-order-customer">
        <Customer::Pill @customer={{@resource.customer}} @titleFallback="No customer" @static={{not @resource.customer.id}} data-test-order-customer-pill />
        <div class="storefront-order-facts mt-2">
            <div><span>Email</span><strong>{{n-a @resource.customer.email "No email"}}</strong></div>
            <div><span>Phone</span><strong>{{n-a @resource.customer.phone "No phone"}}</strong></div>
        </div>

        {{#unless @resource.meta.is_pickup}}
            <div class="storefront-order-detail-block">
                <div class="storefront-order-detail-block__label">Delivery address</div>
                <DisplayPlace @place={{@resource.payload.dropoff}} @type="dropoff" @addressClass="text-sm dark:text-gray-100" @noAddressClass="text-sm" />
            </div>
        {{/unless}}
    </div>
</ContentPanel>
