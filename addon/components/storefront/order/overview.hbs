{{! The 11a order panel body (the first tab): people, delivery, proof of delivery when there is any, items, notes, then the folded paperwork; messages open in a drawer beside the panel. The next step, steps and notices are in the header. }}
<div class="sfop" data-test-order-overview {{did-update this.reload this.order.status this.order.updated_at}}>
    <Storefront::Order::PanelPeople @order={{this.order}} @overview={{this.overview}} @refresh={{this.refresh}} />
    <Storefront::Order::PanelDelivery @order={{this.order}} @overview={{this.overview}} @canEdit={{this.canEdit}} />
    <Storefront::Order::PanelProof @overview={{this.overview}} />
    <Storefront::Order::PanelItems @order={{this.order}} @overview={{this.overview}} @canEdit={{this.canEdit}} @canMarkUnavailable={{this.canMarkUnavailable}} @onMarkUnavailable={{this.setUnavailable}} />
    <Storefront::Order::PanelNotes @order={{this.order}} />
    <Storefront::Order::PanelFolds @order={{this.order}} @overview={{this.overview}} @refresh={{this.refresh}} />
    <Storefront::Order::PanelChatDrawer @order={{this.order}} @onRead={{this.reload}} />
</div>
