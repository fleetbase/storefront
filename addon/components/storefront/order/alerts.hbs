{{! What needs the store's attention on this order, each with the action that resolves it. }}
{{#if this.rows.length}}
    <div class="storefront-order-alerts" data-test-order-alerts>
        {{#each this.rows as |row|}}
            <div class="storefront-order-alert storefront-order-alert--{{row.tone}}" role="status" data-test-order-alert={{row.code}}>
                <FaIcon @icon={{row.icon}} class="storefront-order-alert__icon" />
                <div class="storefront-order-alert__text">
                    <div class="storefront-order-alert__title">{{row.title}}</div>
                    {{#if row.detail}}
                        <div class="storefront-order-alert__detail">{{row.detail}}</div>
                    {{/if}}
                </div>
                {{#if row.actions.length}}
                    <div class="storefront-order-alert__actions">
                        {{#each row.actions as |button|}}
                            <Button @size="xs" @type={{button.type}} @icon={{button.icon}} @text={{button.text}} @permission={{button.permission}} @onClick={{button.onClick}} />
                        {{/each}}
                    </div>
                {{/if}}
            </div>
        {{/each}}
    </div>
{{/if}}
