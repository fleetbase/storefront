{{! What was bought and what it came to: one row per item (quantity, photo, name, options, price), then the totals. }}
<div class="storefront-order-commerce">
    {{#if this.order.payload.entities}}
        <div class="storefront-order-items">
            {{#each this.order.payload.entities as |entity|}}
                <div class="storefront-order-item {{if entity.meta.unavailable 'is-unavailable'}}" data-test-order-item={{entity.public_id}}>
                    <div class="storefront-order-item__qty">{{n-a entity.meta.quantity 1}}x</div>
                    <Image src={{or entity.photo_url entity.image_url entity.meta.photo_url entity.meta.image_url entity.meta.product_image_url}} @fallbackSrc={{config "defaultValues.entityImage"}} class="storefront-order-item__image" alt={{entity.name}} />
                    <div class="storefront-order-item__body">
                        <div class="storefront-order-item__name">{{n-a entity.name (t "storefront.order.sections.unnamed-item")}}</div>
                        <div class="storefront-order-item__description">{{n-a entity.description (t "storefront.order.sections.no-description")}}</div>
                        {{#if entity.meta.scheduled_at}}
                            <div class="storefront-order-item__options">
                                <span>{{t "storefront.order.sections.scheduled-at" date=(format-date-fns entity.meta.scheduled_at "d MMM yyyy HH:mm")}}</span>
                            </div>
                        {{/if}}
                        {{#if entity.meta.variants}}
                            <div class="storefront-order-item__options">
                                {{#each entity.meta.variants as |variant|}}
                                    <span>{{or variant.name variant.label variant.option}}</span>
                                {{/each}}
                            </div>
                        {{/if}}
                        {{#if entity.meta.addons}}
                            <div class="storefront-order-item__options">
                                {{#each entity.meta.addons as |addon|}}
                                    <span>+ {{or addon.name addon.label}}</span>
                                {{/each}}
                            </div>
                        {{/if}}
                        {{#if entity.meta.note}}
                            <div class="storefront-order-item__note">“{{entity.meta.note}}”</div>
                        {{/if}}
                        {{#if entity.meta.unavailable}}
                            <div class="storefront-order-item__flag">{{t "storefront.order.packing.unavailable"}}</div>
                        {{/if}}
                    </div>
                    <div class="storefront-order-item__price">
                        {{format-currency entity.meta.subtotal (or entity.currency this.order.meta.currency)}}
                    </div>
                </div>
            {{/each}}
        </div>
    {{else}}
        <div class="storefront-order-empty-state">
            <FaIcon @icon="receipt" />
            <span>{{t "storefront.order.sections.no-items"}}</span>
        </div>
    {{/if}}

    <div class="storefront-order-totals mt-1">
        <div><span>{{t "storefront.order.sections.subtotal"}}</span><strong>{{format-currency this.order.meta.subtotal this.order.meta.currency}}</strong></div>
        {{#unless this.order.meta.is_pickup}}
            <div><span>{{t "storefront.orders.create.delivery-fee"}}</span><strong>{{format-currency this.order.meta.delivery_fee this.order.meta.currency}}</strong></div>
        {{/unless}}
        {{#each this.promotions as |promotion|}}
            <div class="text-green-600 dark:text-green-400">
                <span>
                    <FaIcon @icon={{if promotion.isFreeDelivery "truck-fast" "tag"}} @size="xs" class="mr-1" />{{promotion.name}}{{#if promotion.code}} · <code>{{promotion.code}}</code>{{/if}}
                </span>
                <strong>-{{format-currency promotion.amount this.order.meta.currency}}</strong>
            </div>
        {{/each}}
        {{#if this.unattributedDiscount}}
            <div class="text-green-600 dark:text-green-400"><span>{{t "storefront.order.sections.discount"}}</span><strong>-{{format-currency this.unattributedDiscount this.order.meta.currency}}</strong></div>
        {{/if}}
        {{#if this.hasTip}}
            <div><span>{{t "storefront.order.sections.tip"}}</span><strong>{{get-tip-amount this.order.meta.tip this.order.meta.subtotal this.order.meta.currency}}</strong></div>
        {{/if}}
        {{#if this.hasDeliveryTip}}
            <div><span>{{t "storefront.order.sections.delivery-tip"}}</span><strong>{{get-tip-amount this.order.meta.delivery_tip this.order.meta.subtotal this.order.meta.currency}}</strong></div>
        {{/if}}
        <div class="storefront-order-totals__total">
            <span>{{t "storefront.order.sections.total"}}</span>
            <strong>{{format-currency (or this.order.meta.total this.order.transaction_amount 0) this.order.meta.currency}}</strong>
        </div>
    </div>
</div>
