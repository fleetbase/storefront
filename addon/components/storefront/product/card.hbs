{{#if (eq @viewMode "list")}}
    <tr class="storefront-products-table__row {{if this.isSelected 'is-selected'}}" data-test-storefront-product-card>
        {{#if @onToggleSelect}}
            <td class="storefront-products-table__check">
                <Checkbox @value={{this.isSelected}} @onToggle={{this.toggleSelect}} aria-label={{t "storefront.common.select"}} data-test-product-select />
            </td>
        {{/if}}
        <td class="storefront-products-table__product">
            <LinkTo @route={{@editRoute}} @model={{@product}} class="storefront-products-table__identity" title={{@product.name}} data-test-product-name>
                <Image src={{this.imageUrl}} @fallbackSrc={{config "defaultValues.placeholderImage"}} alt={{@product.name}} class="storefront-products-table__thumb" />
                <span class="storefront-products-table__name">{{n-a @product.name (t "storefront.products.card.untitled")}}</span>
            </LinkTo>
        </td>
        <td class="storefront-products-table__muted" title={{@product.sku}}>{{n-a @product.sku}}</td>
        <td class="storefront-products-table__muted">{{n-a this.categoryName (t "storefront.products.groups.uncategorized")}}</td>
        <td class="storefront-products-table__price" data-test-product-price>
            {{#if this.hasSalePrice}}
                {{format-currency @product.sale_price @product.currency}}
                <s class="storefront-product-card__compare">{{format-currency @product.price @product.currency}}</s>
            {{else}}
                {{format-currency @product.price @product.currency}}
            {{/if}}
        </td>
        <td><Badge @status={{this.displayStatus}} @size="xs" data-test-product-status /></td>
        <td class="storefront-products-table__muted" title={{this.optionsSummary}} data-test-product-chips>
            {{#if this.hasChips}}{{this.optionsSummary}}{{else}}{{t "storefront.products.card.simple"}}{{/if}}
        </td>
        <td class="storefront-products-table__actions">
            <div class="storefront-card__buttons">
                <LinkTo @route={{@editRoute}} @model={{@product}} disabled={{cannot "storefront update product"}} class="btn btn-xs btn-default" aria-label={{concat (t "storefront.common.edit") " " @product.name}}>
                    <FaIcon @icon="pencil" />
                </LinkTo>
                <DropdownButton @icon="ellipsis-h" @size="xs" @iconPrefix="fas" @renderInPlace={{false}} @helpText={{t "storefront.common.more"}} data-test-product-menu as |dd|>
                    <div class="next-dd-menu mt-1 mx-0">
                        <div class="px-1">
                            <a href="javascript:;" class="next-dd-item" {{on "click" (dropdown-fn dd this.previewImage)}}><FaIcon @icon="expand" class="mr-1" />{{t "storefront.common.preview"}}</a>
                            <a href="javascript:;" class="next-dd-item text-danger" {{on "click" (dropdown-fn dd @onDelete @product)}} data-test-product-delete><FaIcon @icon="trash" class="mr-1" />{{t "storefront.common.delete"}}</a>
                        </div>
                    </div>
                </DropdownButton>
            </div>
        </td>
    </tr>
{{else}}
    <Layout::Resource::Card class="storefront-product-card {{if this.isSelected 'is-selected'}} {{if this.isDraft 'is-draft'}}" data-test-storefront-product-card ...attributes as |Card|>
        <Card.body class="storefront-product-card__body {{@bodyClass}}">
            <div class="storefront-product-card__media">
                <LinkTo @route={{@editRoute}} @model={{@product}} class="storefront-product-card__media-link" aria-label={{concat (t "storefront.common.edit") " " @product.name}}>
                    <Image src={{this.imageUrl}} @fallbackSrc={{config "defaultValues.placeholderImage"}} alt={{@product.name}} class="storefront-product-card__image" data-test-product-image />
                </LinkTo>
                <div class="storefront-product-card__flags">
                    {{#if @onToggleSelect}}
                        <span class="storefront-product-card__select {{if this.isSelected 'is-selected'}}">
                            <Checkbox @value={{this.isSelected}} @onToggle={{this.toggleSelect}} aria-label={{t "storefront.common.select"}} data-test-product-select />
                        </span>
                    {{/if}}
                    <Badge @status={{this.displayStatus}} @size="xs" @hideStatusDot={{true}} data-test-product-status />
                    {{#if @product.is_on_sale}}<Badge @status="success" @size="xs" @hideStatusDot={{true}} @text={{t "storefront.products.groups.on-sale"}} />{{/if}}
                    {{#if @product.is_recommended}}<Badge @status="info" @size="xs" @hideStatusDot={{true}} @text={{t "storefront.products.groups.recommended"}} />{{/if}}
                    {{#if this.isOutOfStock}}<Badge @status="warning" @size="xs" @hideStatusDot={{true}} @text={{t "storefront.products.card.unavailable"}} />{{/if}}
                </div>
                <button type="button" class="storefront-product-card__preview" aria-label={{concat (t "storefront.common.preview") " " @product.name}} {{on "click" this.previewImage}}>
                    <FaIcon @icon="expand" @size="xs" />
                </button>
            </div>
            <div class="storefront-product-card__info">
                <RegistryYield @registry="storefront:component:product:card:header:start" as |RegistryComponent|>
                    <RegistryComponent @product={{@product}} @resource={{@product}} />
                </RegistryYield>
                <div class="storefront-product-card__eyebrow">{{n-a this.categoryName (t "storefront.products.groups.uncategorized")}}{{#if @product.sku}} · {{@product.sku}}{{/if}}</div>
                <LinkTo @route={{@editRoute}} @model={{@product}} class="storefront-product-card__title" title={{@product.name}} data-test-product-name>{{n-a @product.name (t "storefront.products.card.untitled")}}</LinkTo>
                <div class="storefront-product-card__price" data-test-product-price>
                    {{#if this.hasSalePrice}}
                        <strong>{{format-currency @product.sale_price @product.currency}}</strong>
                        <s class="storefront-product-card__compare">{{format-currency @product.price @product.currency}}</s>
                    {{else}}
                        <strong>{{format-currency @product.price @product.currency}}</strong>
                    {{/if}}
                </div>
                {{#if this.hasChips}}
                    <div class="storefront-product-card__meta" data-test-product-chips>
                        {{#if this.variantCount}}<span><FaIcon @icon="layer-group" @size="xs" />{{t "storefront.products.card.variants" count=this.variantCount}}</span>{{/if}}
                        {{#if this.addonGroupCount}}<span><FaIcon @icon="tags" @size="xs" />{{t "storefront.products.card.addons" count=this.addonGroupCount}}</span>{{/if}}
                        {{#if this.catalogsCount}}<span data-test-product-catalogs><FaIcon @icon="book-open" @size="xs" />{{t "storefront.products.card.in-catalogs" count=this.catalogsCount}}</span>{{/if}}
                        {{#if @product.is_service}}<span><FaIcon @icon="concierge-bell" @size="xs" />{{t "storefront.products.card.service"}}</span>{{/if}}
                        {{#if @product.is_bookable}}<span><FaIcon @icon="calendar-check" @size="xs" />{{t "storefront.products.card.bookable"}}</span>{{/if}}
                    </div>
                {{/if}}
                {{#if (and this.isDraft this.missing.length)}}
                    <div class="storefront-product-card__note" data-test-product-missing>
                        <FaIcon @icon="triangle-exclamation" @size="xs" />{{t "storefront.products.card.missing" items=(join ", " this.missing)}}
                    </div>
                {{/if}}
                <RegistryYield @registry="storefront:component:product:card:header:end" as |RegistryComponent|>
                    <RegistryComponent @product={{@product}} @resource={{@product}} />
                </RegistryYield>
            </div>
        </Card.body>
        <Card.footer class="storefront-product-card__footer {{@footerClass}}">
            <RegistryYield @registry="storefront:component:product:card:footer:start" as |RegistryComponent|>
                <RegistryComponent @product={{@product}} @resource={{@product}} />
            </RegistryYield>
            <span class="storefront-product-card__updated" title={{t "storefront.products.card.updated" ago=(n-a @product.updatedAgo)}}><FaIcon @icon="clock" @prefix="far" @size="xs" />{{t "storefront.products.card.ago" ago=(n-a @product.updatedAgo)}}</span>
            <div class="storefront-card__buttons">
                <LinkTo @route={{@editRoute}} @model={{@product}} disabled={{cannot "storefront update product"}} class="btn btn-xs btn-default" aria-label={{concat (t "storefront.common.edit") " " @product.name}}>
                    <FaIcon @icon="pencil" />
                </LinkTo>
                <DropdownButton @icon="ellipsis-h" @size="xs" @iconPrefix="fas" @renderInPlace={{false}} @helpText={{t "storefront.common.more"}} data-test-product-menu as |dd|>
                    <div class="next-dd-menu mt-1 mx-0">
                        <div class="px-1">
                            <a href="javascript:;" class="next-dd-item" {{on "click" (dropdown-fn dd this.previewImage)}}><FaIcon @icon="expand" class="mr-1" />{{t "storefront.common.preview"}}</a>
                            <a href="javascript:;" class="next-dd-item text-danger" {{on "click" (dropdown-fn dd @onDelete @product)}} data-test-product-delete><FaIcon @icon="trash" class="mr-1" />{{t "storefront.common.delete"}}</a>
                        </div>
                    </div>
                </DropdownButton>
            </div>
            <RegistryYield @registry="storefront:component:product:card:footer:end" as |RegistryComponent|>
                <RegistryComponent @product={{@product}} @resource={{@product}} />
            </RegistryYield>
        </Card.footer>
    </Layout::Resource::Card>
{{/if}}
