{{#if (eq @viewMode "list")}}
    <div class="storefront-product-row {{if this.isSelected 'is-selected'}}" data-test-storefront-product-card>
        {{#if @onToggleSelect}}
            <button type="button" class="storefront-product-card__select" aria-pressed={{if this.isSelected "true" "false"}} {{on "click" this.toggleSelect}} data-test-product-select>
                <FaIcon @icon={{if this.isSelected "check-square" "square"}} @prefix="far" />
            </button>
        {{/if}}
        <LinkTo @route={{@editRoute}} @model={{@product}} class="storefront-product-row__product">
            <Image src={{this.imageUrl}} @fallbackSrc="https://flb-assets.s3.ap-southeast-1.amazonaws.com/static/image-file-icon.png" alt={{@product.name}} class="storefront-product-row__image" />
            <span class="storefront-product-row__copy">
                <strong>{{n-a @product.name "Untitled product"}}</strong>
                <small>{{n-a @product.description "No description"}}</small>
                <span class="storefront-product-row__sku">{{n-a @product.sku "No SKU"}}</span>
            </span>
        </LinkTo>
        <span class="storefront-product-row__price">
            {{#if this.hasSalePrice}}
                {{format-currency @product.sale_price @product.currency}}
            {{else}}
                {{format-currency @product.price @product.currency}}
            {{/if}}
        </span>
        <span><Badge @status={{this.displayStatus}} /></span>
        <span class="storefront-product-row__muted">{{this.variantCount}} variants · {{this.addonGroupCount}} add-ons</span>
        <span class="storefront-product-row__actions">
            <LinkTo
                @route={{@editRoute}}
                @model={{@product}}
                disabled={{cannot "storefront update product"}}
                class="btn btn-xs btn-default"
                aria-label={{concat "Edit " @product.name}}
            >
                <FaIcon @icon="pencil" />
            </LinkTo>
            <Button
                @type="danger"
                @size="xs"
                @icon="trash"
                @onClick={{fn @onDelete @product}}
                @permission="storefront delete product"
            />
        </span>
    </div>
{{else}}
    <Layout::Resource::Card class="storefront-card storefront-product-card {{if this.isSelected 'is-selected'}} {{if this.isDraft 'is-draft'}}" data-test-storefront-product-card ...attributes as |Card|>
        <Card.header class={{@headerClass}}>
            <RegistryYield @registry="storefront:component:product:card:header:start" as |RegistryComponent|>
                <RegistryComponent @product={{@product}} @resource={{@product}} />
            </RegistryYield>
            <div class="storefront-card__title">
                {{#if @onToggleSelect}}
                    <button type="button" class="storefront-card__select" aria-pressed={{if this.isSelected "true" "false"}} aria-label={{t "storefront.common.select"}} {{on "click" this.toggleSelect}} data-test-product-select>
                        <FaIcon @icon={{if this.isSelected "check-square" "square"}} @prefix="far" />
                    </button>
                {{/if}}
                <LinkTo @route={{@editRoute}} @model={{@product}} class="storefront-card__title-text" data-test-product-name>{{n-a @product.name (t "storefront.products.card.untitled")}}</LinkTo>
                <Badge @status={{this.displayStatus}} @size="xs" @hideStatusDot={{true}} data-test-product-status />
            </div>
            <div class="storefront-card__subtitle">{{n-a this.categoryName (t "storefront.products.groups.uncategorized")}}{{#if @product.sku}} · {{@product.sku}}{{/if}}</div>
            <RegistryYield @registry="storefront:component:product:card:header:end" as |RegistryComponent|>
                <RegistryComponent @product={{@product}} @resource={{@product}} />
            </RegistryYield>
        </Card.header>
        <Card.body class="storefront-card__media-body {{@bodyClass}}">
            <LinkTo @route={{@editRoute}} @model={{@product}} class="storefront-card__media-link" aria-label={{concat (t "storefront.common.edit") " " @product.name}}>
                <Image src={{this.imageUrl}} @fallbackSrc={{config "defaultValues.placeholderImage"}} alt={{@product.name}} class="storefront-card__media" data-test-product-image />
            </LinkTo>
            {{#if (or @product.is_recommended @product.is_on_sale this.isOutOfStock)}}
                <div class="storefront-card__media-badges">
                    {{#if @product.is_recommended}}<Badge @status="info" @size="xs" @hideStatusDot={{true}} @text={{t "storefront.products.groups.recommended"}} />{{/if}}
                    {{#if @product.is_on_sale}}<Badge @status="success" @size="xs" @hideStatusDot={{true}} @text={{t "storefront.products.groups.on-sale"}} />{{/if}}
                    {{#if this.isOutOfStock}}<Badge @status="warning" @size="xs" @hideStatusDot={{true}} @text={{t "storefront.catalogs.editor.out-of-stock"}} />{{/if}}
                </div>
            {{/if}}
            <button type="button" class="storefront-card__media-action" aria-label={{concat (t "storefront.common.preview") " " @product.name}} {{on "click" this.previewImage}}>
                <FaIcon @icon="expand" @size="xs" />
            </button>
        </Card.body>
        <Card.footer class={{@footerClass}}>
            <RegistryYield @registry="storefront:component:product:card:footer:start" as |RegistryComponent|>
                <RegistryComponent @product={{@product}} @resource={{@product}} />
            </RegistryYield>
            <div class="storefront-card__actions">
                <span class="storefront-card__price" data-test-product-price>
                    {{#if this.hasSalePrice}}
                        <strong>{{format-currency @product.sale_price @product.currency}}</strong>
                        <s class="storefront-card__price-compare">{{format-currency @product.price @product.currency}}</s>
                    {{else}}
                        <strong>{{format-currency @product.price @product.currency}}</strong>
                    {{/if}}
                </span>
                <div class="storefront-card__buttons">
                    <LinkTo @route={{@editRoute}} @model={{@product}} disabled={{cannot "storefront update product"}} class="btn btn-xs btn-default" aria-label={{concat (t "storefront.common.edit") " " @product.name}}>
                        <FaIcon @icon="pencil" />
                    </LinkTo>
                    <Button @type="danger" @size="xs" @icon="trash" @helpText={{t "storefront.common.delete"}} @onClick={{fn @onDelete @product}} @permission="storefront delete product" />
                </div>
            </div>
            <div class="storefront-card__chips">
                <span class="storefront-card__chip">{{t "storefront.products.card.variants" count=this.variantCount}}</span>
                <span class="storefront-card__chip">{{t "storefront.products.card.addons" count=this.addonGroupCount}}</span>
                {{#if @product.is_service}}<span class="storefront-card__chip">{{t "storefront.products.card.service"}}</span>{{/if}}
                {{#if @product.is_bookable}}<span class="storefront-card__chip">{{t "storefront.products.card.bookable"}}</span>{{/if}}
            </div>
            {{#if (and this.isDraft this.missing.length)}}
                <div class="storefront-card__note storefront-card__note--warning" data-test-product-missing>
                    <FaIcon @icon="triangle-exclamation" @size="xs" class="mr-1" />{{t "storefront.products.card.missing" items=(join ", " this.missing)}}
                </div>
            {{else if this.isOutOfStock}}
                <div class="storefront-card__note storefront-card__note--warning" data-test-product-missing>
                    <FaIcon @icon="box-open" @size="xs" class="mr-1" />{{t "storefront.products.card.restock-hint"}}
                </div>
            {{/if}}
            <div class="storefront-card__meta">
                <span>{{t "storefront.common.last-modified"}}: {{n-a @product.updatedAgo}}</span>
            </div>
            <RegistryYield @registry="storefront:component:product:card:footer:end" as |RegistryComponent|>
                <RegistryComponent @product={{@product}} @resource={{@product}} />
            </RegistryYield>
        </Card.footer>
    </Layout::Resource::Card>
{{/if}}
