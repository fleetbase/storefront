{{! Each attached add-on group: its name and how many of its add-ons this product offers; untick to hide one. }}
<div class="storefront-option-groups" data-test-product-addons>
    {{#each @groups as |group|}}
        <div class="storefront-option-group" data-test-product-addon-group={{group.name}}>
            <div class="storefront-option-group__head">
                <div class="storefront-option-group__title">
                    <strong>{{group.name}}</strong>
                    <span class="storefront-option-group__meta">{{t "storefront.products.form.addons.offered" offered=group.offered total=group.total}}</span>
                </div>
                <div class="storefront-option-group__actions">
                    <Button @size="xs" @icon="trash" @helpText={{t "storefront.products.form.addons.remove-group"}} aria-label={{t "storefront.products.form.addons.remove-group"}} @onClick={{fn @removeAddonCategory group.index}} @permission="storefront delete product-addon" />
                </div>
            </div>
            {{#each group.addons as |row|}}
                <label class="storefront-option-group__addon {{unless row.isOffered 'is-hidden'}}">
                    <Checkbox @value={{row.isOffered}} @onToggle={{fn @excludeAddon group.index row.addon}} disabled={{cannot "storefront update product-addon"}} />
                    <span class="storefront-option-group__addon-text">
                        <span class="storefront-option-group__addon-name">{{row.addon.name}}</span>
                        <span class="storefront-option-group__addon-description">{{n-a row.addon.description (t "storefront.products.form.addons.no-description")}}</span>
                    </span>
                    {{#unless row.isOffered}}<Badge @status="default" @size="xs" @hideStatusDot={{true}} @text={{t "storefront.products.form.addons.hidden"}} />{{/unless}}
                    <span class="storefront-option-group__addon-price">{{format-currency row.addon.price @currency}}</span>
                </label>
            {{else}}
                <div class="storefront-option-group__empty">{{t "storefront.products.form.addons.group-empty"}}</div>
            {{/each}}
        </div>
    {{else}}
        <div class="storefront-panel-empty storefront-panel-empty--inline">
            <span class="storefront-panel-empty__icon"><FaIcon @icon="tags" /></span>
            <div class="storefront-panel-empty__help">{{t "storefront.products.form.addons.none"}}</div>
        </div>
    {{/each}}
</div>
