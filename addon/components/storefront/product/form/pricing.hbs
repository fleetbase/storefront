<ContentPanel @title={{t "storefront.products.form.sections.pricing"}} @open={{true}} @wrapperClass="bordered-top">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
        <InputGroup @name={{t "storefront.products.form.fields.price"}} @helpText={{t "storefront.products.form.fields.price-help"}}>
            <MoneyInput
                class="w-full"
                @currency={{if @product.currency @product.currency @activeStore.currency}}
                @value={{@product.price}}
                @canSelectCurrency={{false}}
                @onCurrencyChange={{fn (mut @product.currency)}}
                @disabled={{@disabled}}
            />
        </InputGroup>
        <InputGroup @name={{t "storefront.products.form.fields.sale-price"}} @helpText={{t "storefront.products.form.fields.sale-price-help"}}>
            <MoneyInput
                class="w-full"
                @currency={{if @product.currency @product.currency @activeStore.currency}}
                @value={{@product.sale_price}}
                @canSelectCurrency={{false}}
                @onCurrencyChange={{fn (mut @product.currency)}}
                @disabled={{@disabled}}
            />
        </InputGroup>
    </div>
</ContentPanel>
