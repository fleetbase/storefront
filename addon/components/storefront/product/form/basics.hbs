<ContentPanel @title={{t "storefront.products.form.sections.product"}} @open={{true}} @wrapperClass="bordered-top">
    <InputGroup @name={{t "storefront.products.form.fields.name"}} @value={{@product.name}} @disabled={{@disabled}} />
    <InputGroup @name={{t "storefront.products.form.fields.description"}}>
        <Textarea @value={{@product.description}} class="form-input w-full" placeholder={{t "storefront.products.form.fields.description-placeholder"}} disabled={{@disabled}} rows={{4}} />
    </InputGroup>
    <InputGroup @name={{t "storefront.products.form.fields.category"}}>
        <ModelSelect
            @modelName="category"
            @selectedModel={{@product.category}}
            @query={{hash for="storefront_product" owner_uuid=@activeStore.id}}
            @placeholder={{t "storefront.products.form.fields.category-placeholder"}}
            @triggerClass="form-select form-input"
            @infiniteScroll={{false}}
            @renderInPlace={{true}}
            @allowClear={{true}}
            @onChange={{fn (mut @product.category)}}
            @onChangeId={{fn (mut @product.category_uuid)}}
            as |model|
        >
            <div class="flex items-center">
                <span class="uppercase">{{model.name}}</span>
            </div>
        </ModelSelect>
    </InputGroup>
    <InputGroup @name={{t "storefront.products.form.fields.sku"}} @value={{@product.sku}} @helpText={{t "storefront.products.form.fields.sku-help"}} @disabled={{@disabled}} />
    <InputGroup @name={{t "storefront.products.form.fields.tags"}}>
        <TagInput
            class="form-input"
            @placeholder={{t "storefront.products.form.fields.tags-placeholder"}}
            @allowSpacesInTags={{true}}
            @tags={{@product.tags}}
            @addTag={{@addTag}}
            @removeTagAtIndex={{@removeTag}}
            @disabled={{@disabled}}
            as |tag|
        >
            {{tag}}
        </TagInput>
    </InputGroup>
</ContentPanel>
