<Overlay @position="right" @isResizable={{true}} @noBackdrop={{false}} @width="620px" @minResizeWidth={{520}} @fullHeight={{true}} @isOpen={{true}}>
    <Overlay::Header @title={{this.title}} @onPressCancel={{this.close}}>
        <:actions>
            {{#unless this.campaign.isNew}}
                <Badge @status={{this.campaign.status}} @size="xs" data-test-campaign-panel-status />
            {{/unless}}
        </:actions>
    </Overlay::Header>
    <Overlay::Body class="p-0i storefront-overlay-body" @wrapperClass="storefront-form-panel" data-test-campaign-panel>
        <div class="storefront-form-panel__body">
            {{#if this.isReadOnly}}
                <p class="storefront-form-panel__note">{{t "storefront.promotions.campaigns.read-only-help"}}</p>
            {{/if}}
            <fieldset disabled={{this.isReadOnly}} class="form-wrapper min-w-0">
                <InputGroup
                    @name={{t "storefront.promotions.common.name"}}
                    @value={{this.campaign.name}}
                    @placeholder={{t "storefront.promotions.campaigns.name-placeholder"}}
                    @helpText={{t "storefront.promotions.campaigns.name-help"}}
                    @required={{true}}
                    maxlength="191"
                    data-test-campaign-name
                />
                <InputGroup
                    @name={{t "storefront.promotions.campaigns.title-label"}}
                    @value={{this.campaign.title}}
                    @placeholder={{t "storefront.promotions.campaigns.title-placeholder"}}
                    @required={{true}}
                    maxlength="191"
                />
                <InputGroup @name={{t "storefront.promotions.campaigns.body-label"}} @required={{true}} as |id|>
                    <Textarea id={{id}} @value={{this.campaign.body}} placeholder={{t "storefront.promotions.campaigns.body-placeholder"}} class="form-input w-full" rows="3" maxlength="2000" required />
                </InputGroup>

                <div class="storefront-form-panel__section">
                    <InputGroup @name={{t "storefront.promotions.campaigns.audience"}} @helpText={{t "storefront.promotions.campaigns.audience-help"}} as |id|>
                        <ModelSelect
                            @modelName="customer-segment"
                            @selectedModel={{this.segment}}
                            @query={{hash owner=this.campaign.owner_uuid}}
                            @placeholder={{t "storefront.promotions.common.all-customers"}}
                            @triggerId={{id}}
                            @triggerClass="form-select form-input"
                            @renderInPlace={{true}}
                            @infiniteScroll={{false}}
                            @allowClear={{true}}
                            @disabled={{this.isReadOnly}}
                            @onChange={{this.setSegment}}
                            as |segment|
                        >
                            {{segment.name}}
                        </ModelSelect>
                    </InputGroup>
                    {{#if this.hasAudienceCount}}
                        <p class="storefront-form-panel__hint" data-test-campaign-audience-count>{{t "storefront.promotions.campaigns.audience-count" count=this.audienceCount}}</p>
                    {{/if}}
                    <InputGroup @name={{t "storefront.promotions.campaigns.channels"}} @helpText={{t "storefront.promotions.campaigns.channels-help"}} @required={{true}}>
                        <div class="flex flex-wrap gap-x-6 gap-y-3 py-1">
                            <Checkbox @value={{this.hasChannel "push"}} @label={{t "storefront.promotions.campaigns.channel-push"}} @disabled={{this.isReadOnly}} @onToggle={{fn this.toggleChannel "push"}} />
                            <Checkbox @value={{this.hasChannel "inbox"}} @label={{t "storefront.promotions.campaigns.channel-inbox"}} @disabled={{this.isReadOnly}} @onToggle={{fn this.toggleChannel "inbox"}} />
                        </div>
                    </InputGroup>
                </div>

                <div class="storefront-form-panel__section grid grid-cols-1 gap-4 md:grid-cols-2">
                    <InputGroup @name={{t "storefront.promotions.campaigns.promotion"}} @helpText={{t "storefront.promotions.campaigns.promotion-help"}} as |id|>
                        <ModelSelect
                            @modelName="promotion"
                            @selectedModel={{this.promotion}}
                            @query={{hash owner=this.campaign.owner_uuid}}
                            @placeholder={{t "storefront.promotions.campaigns.promotion-placeholder"}}
                            @triggerId={{id}}
                            @triggerClass="form-select form-input"
                            @renderInPlace={{true}}
                            @infiniteScroll={{false}}
                            @allowClear={{true}}
                            @disabled={{this.isReadOnly}}
                            @onChange={{this.setPromotion}}
                            as |promotion|
                        >
                            {{promotion.name}}
                        </ModelSelect>
                    </InputGroup>
                    {{#unless this.promotion}}
                        <InputGroup @name={{t "storefront.promotions.campaigns.link-url"}} @helpText={{t "storefront.promotions.campaigns.link-help"}} as |id|>
                            <Input id={{id}} @type="url" class="form-input w-full" placeholder={{t "storefront.promotions.campaigns.link-placeholder"}} @value={{this.linkUrl}} {{on "input" this.setLinkUrl}} />
                        </InputGroup>
                    {{/unless}}
                </div>

                {{#if this.campaign.isEditable}}
                    <div class="storefront-form-panel__section">
                        <InputGroup @name={{t "storefront.promotions.campaigns.when"}}>
                            <div class="flex flex-wrap gap-2" role="radiogroup" data-test-campaign-when>
                                {{#each this.whenOptions as |option|}}
                                    <Button @size="sm" @type={{if (eq this.when option) "primary" "default"}} @text={{t (concat "storefront.promotions.campaigns.when-" option)}} @onClick={{fn this.setWhen option}} role="radio" aria-checked={{if (eq this.when option) "true" "false"}} data-test-campaign-when-option={{option}} />
                                {{/each}}
                            </div>
                        </InputGroup>
                        {{#if (eq this.when "schedule")}}
                            <InputGroup @name={{t "storefront.promotions.campaigns.send-at"}} @helpText={{t "storefront.promotions.campaigns.schedule-help"}} @required={{true}}>
                                <DateTimeInput class="form-input w-full" @value={{this.campaign.send_at}} @onUpdate={{fn (mut this.campaign.send_at)}} data-test-campaign-send-at />
                            </InputGroup>
                        {{/if}}
                    </div>
                {{/if}}
            </fieldset>
        </div>

        <div class="storefront-save-bar storefront-form-panel__save-bar {{if this.isDirty 'is-dirty'}}" data-test-campaign-panel-save-bar>
            <div class="storefront-save-bar__status">
                {{#if this.isReadOnly}}
                    <FaIcon @icon="lock" @size="xs" class="mr-2" />{{t "storefront.promotions.campaigns.view-campaign"}}
                {{else if this.isDirty}}
                    <FaIcon @icon="circle" @size="xs" class="text-amber-500 mr-2" />{{t "storefront.trucks.panel.unsaved"}}
                {{else}}
                    <FaIcon @icon="check" @size="xs" class="text-green-500 mr-2" />{{t "storefront.settings.save-bar.saved"}}
                {{/if}}
            </div>
            <div class="storefront-save-bar__actions">
                <Button @text={{if this.isReadOnly (t "storefront.promotions.common.done") (t "storefront.promotions.common.cancel")}} @onClick={{this.close}} data-test-campaign-panel-cancel />
                {{#unless this.isReadOnly}}
                    <Button @type="primary" @icon={{this.saveIcon}} @text={{this.saveLabel}} @isLoading={{this.save.isRunning}} @onClick={{perform this.save}} @permission={{if this.campaign.isNew "storefront create campaign" "storefront update campaign"}} data-test-campaign-panel-save />
                {{/unless}}
            </div>
        </div>
    </Overlay::Body>
</Overlay>
