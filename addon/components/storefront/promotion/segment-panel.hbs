<Overlay @position="right" @isResizable={{true}} @noBackdrop={{false}} @width="620px" @minResizeWidth={{520}} @fullHeight={{true}} @isOpen={{true}}>
    <Overlay::Header @title={{this.title}} @onPressCancel={{this.close}}>
        <:actions>
            <span role="status" aria-live="polite" class="storefront-form-panel__status" data-test-segment-matching>
                {{#if this.isLoadingCount}}
                    {{t "storefront.promotions.segments.matching-loading"}}
                {{else if this.countUnavailable}}
                    {{t "storefront.promotions.segments.matching-unavailable"}}
                {{else if this.hasMatching}}
                    <Badge @status="info" @hideStatusDot={{true}}>{{t "storefront.promotions.segments.matching" count=this.matching}}</Badge>
                {{/if}}
            </span>
        </:actions>
    </Overlay::Header>
    <Overlay::Body class="p-0i storefront-overlay-body" @wrapperClass="storefront-form-panel" data-test-segment-panel>
        <div class="storefront-form-panel__body form-wrapper">
            <InputGroup @name={{t "storefront.promotions.common.name"}} @value={{this.segment.name}} @placeholder={{t "storefront.promotions.segments.name-placeholder"}} @required={{true}} maxlength="191" data-test-segment-name />
            <InputGroup @name={{t "storefront.promotions.common.description"}} as |id|>
                <Textarea id={{id}} @value={{this.segment.description}} placeholder={{t "storefront.promotions.segments.description-placeholder"}} class="form-input w-full" rows="2" />
            </InputGroup>

            <div class="storefront-form-panel__section">
                <h4 class="storefront-form-panel__heading">{{t "storefront.promotions.segments.rules"}}</h4>
                <p class="storefront-form-panel__hint mb-4">{{t "storefront.promotions.segments.rules-help"}}</p>
                <div class="grid grid-cols-1 gap-4 md:grid-cols-2">
                    {{#each this.numberRules as |rule|}}
                        <InputGroup @name={{t rule.label}} as |id|>
                            <Input id={{id}} @type="number" min={{rule.minimum}} step="1" placeholder={{t rule.placeholder}} class="form-input w-full" @value={{get this.rules rule.key}} {{on "input" (fn this.setNumberRule rule.key)}} data-test-segment-rule={{rule.key}} />
                        </InputGroup>
                    {{/each}}
                    <InputGroup @name={{t "storefront.promotions.segments.min-spent"}} @helpText={{t "storefront.promotions.segments.min-spent-help"}} as |id|>
                        <MoneyInput id={{id}} class="w-full" placeholder={{t "storefront.promotions.segments.spend-placeholder"}} @currency={{@currency}} @value={{this.rules.min_spent}} @canSelectCurrency={{false}} @onChange={{fn this.setMoneyRule "min_spent"}} />
                    </InputGroup>
                </div>
                <div class="mt-4">
                    <Toggle @isToggled={{this.rules.has_push_device}} @onToggle={{fn this.setBooleanRule "has_push_device"}} @label={{t "storefront.promotions.segments.has-push-device"}} />
                </div>
            </div>
        </div>

        <div class="storefront-save-bar storefront-form-panel__save-bar {{if this.isDirty 'is-dirty'}}" data-test-segment-panel-save-bar>
            <div class="storefront-save-bar__status">
                {{#if this.isDirty}}
                    <FaIcon @icon="circle" @size="xs" class="text-amber-500 mr-2" />{{t "storefront.trucks.panel.unsaved"}}
                {{else}}
                    <FaIcon @icon="check" @size="xs" class="text-green-500 mr-2" />{{t "storefront.settings.save-bar.saved"}}
                {{/if}}
            </div>
            <div class="storefront-save-bar__actions">
                <Button @text={{t "storefront.promotions.common.cancel"}} @onClick={{this.close}} data-test-segment-panel-cancel />
                <Button @type="primary" @icon="save" @text={{t "storefront.promotions.common.save"}} @isLoading={{this.save.isRunning}} @onClick={{perform this.save}} @permission={{if this.segment.isNew "storefront create customer-segment" "storefront update customer-segment"}} data-test-segment-panel-save />
            </div>
        </div>
    </Overlay::Body>
</Overlay>
