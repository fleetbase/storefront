<div class="storefront-dashboard-widget storefront-orders-widget flex h-full flex-col rounded-md border bg-white shadow-sm dark:bg-gray-800" ...attributes>
    <div class="storefront-orders-header">
        <div class="min-w-0">
            <div class="storefront-widget-title">{{this.title}}</div>
            <div class="storefront-widget-subtitle">{{t "storefront.component.widget.orders.recent-count" count=this.orders.length}}{{#if this.orders.length}} · {{format-currency this.total this.currency}}{{/if}}</div>
        </div>
        <div class="storefront-orders-actions">
            <Button @icon="refresh" @size="xs" @helpText={{t "storefront.component.widget.orders.refresh"}} @onClick={{perform this.loadOrders}} />
            <Toggle @label={{t "storefront.component.widget.orders.active-only"}} @isToggled={{this.activeFilter}} @onToggle={{this.toggleActiveFilter}} />
            <Button @size="xs" @text={{t "storefront.component.widget.orders.all-orders"}} @onClick={{this.viewAllOrders}} data-test-orders-widget-all />
        </div>
    </div>

    {{#if (media "isMobile")}}
        <div class="storefront-orders-mobile-list">
            {{#each this.orders as |order|}}
                <article class="storefront-order-card storefront-animate-card">
                    <div class="flex items-start justify-between gap-3">
                        <div class="min-w-0">
                            <a href="javascript:;" {{on "click" (fn this.viewOrder order)}} class="storefront-order-id">{{order.public_id}}</a>
                            <div class="storefront-order-meta">{{order.createdAgo}}</div>
                        </div>
                        <div class="text-right">
                            <div class="storefront-order-total">{{format-currency order.meta.total order.meta.currency}}</div>
                            <Badge @status={{order.status}} />
                        </div>
                    </div>

                    <div class="storefront-order-card-details">
                        <Customer::Pill @customer={{order.customer}} @static={{not order.customer.id}} />
                        {{#if order.meta.is_pickup}}
                            <span>{{t "storefront.component.widget.orders.pickup-order"}}</span>
                        {{else}}
                            <Driver::Pill @driver={{order.driver_assigned}} @titleFallback="No driver assigned" @static={{not order.driver_assigned.id}} />
                        {{/if}}
                    </div>

                    <div class="storefront-order-card-actions">
                        <Button @size="xs" @type="default" @icon="eye" @helpText={{t "storefront.common.view"}} @onClick={{fn this.viewOrder order}} />
                        <Storefront::Order::Actions @order={{order}} @onChange={{this.handleOrderChange}} />
                    </div>
                </article>
            {{else}}
                <div class="storefront-widget-empty">{{t "storefront.component.widget.orders.empty"}}</div>
            {{/each}}
        </div>
    {{else}}
        <div class="storefront-orders-table-wrap {{unless this.orders 'empty-state'}}">
            <table class="storefront-orders-table">
                <thead>
                    <tr>
                        <th>{{t "storefront.component.widget.orders.order"}}</th>
                        <th>{{t "storefront.common.customer"}}</th>
                        <th>{{t "storefront.networks.orders.columns.fulfillment"}}</th>
                        <th>{{t "storefront.common.driver"}}</th>
                        <th>{{t "storefront.common.total"}}</th>
                        <th>{{t "storefront.common.status"}}</th>
                        <th>{{t "storefront.networks.orders.columns.placed"}}</th>
                        <th>{{t "storefront.component.widget.orders.next"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each this.rows as |row|}}
                        <tr class="storefront-animate-row" data-test-orders-widget-row={{row.order.public_id}}>
                            <td>
                                <a href="javascript:;" {{on "click" (fn this.viewOrder row.order)}} class="storefront-order-id">{{row.order.public_id}}</a>
                            </td>
                            <td><Customer::Pill @customer={{row.order.customer}} @subtitle={{null}} @static={{not row.order.customer.id}} /></td>
                            <td>
                                {{#if row.isPickup}}
                                    <Badge @hideStatusDot={{true}} @status="info" @text={{t "storefront.common.pickup"}} />
                                {{else}}
                                    <Badge @hideStatusDot={{true}} @status="default" @text={{t "storefront.common.delivery"}} />
                                {{/if}}
                            </td>
                            <td>
                                {{#if row.hasDriver}}
                                    <Driver::Pill @driver={{row.driver}} @subtitle={{null}} @showOnlineIndicator={{true}} />
                                {{else if row.isPickup}}
                                    <span class="storefront-table-muted">{{t "storefront.component.widget.orders.driver-not-needed"}}</span>
                                {{else}}
                                    <span class="storefront-table-muted">{{t "storefront.component.widget.orders.unassigned"}}</span>
                                {{/if}}
                            </td>
                            <td><span class="storefront-order-total">{{format-currency row.order.meta.total row.order.meta.currency}}</span></td>
                            <td><Badge @status={{row.order.status}} /></td>
                            <td><span class="storefront-table-muted">{{format-date-fns row.order.created_at "d MMM, HH:mm"}}</span></td>
                            <td>
                                <div class="storefront-table-actions">
                                    {{#if row.next}}
                                        <Button @size="xs" @type={{or row.next.type "primary"}} @icon={{row.next.icon}} @text={{row.next.text}} @onClick={{row.next.fn}} @permission="storefront update order" data-test-orders-widget-next />
                                    {{/if}}
                                    <Storefront::Order::Actions @order={{row.order}} @onChange={{this.handleOrderChange}} @asMenu={{true}} />
                                </div>
                            </td>
                        </tr>
                    {{else}}
                        <tr>
                            <td colspan="8">
                                <div class="storefront-widget-empty">{{t "storefront.component.widget.orders.empty"}}</div>
                            </td>
                        </tr>
                    {{/each}}
                </tbody>
            </table>
        </div>
    {{/if}}
</div>
