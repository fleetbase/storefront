{{#if this.activeContext}}
    <div class={{@wrapperClass}} {{did-insert this.setupTrigger}} {{will-destroy this.close}} ...attributes>
        <Button
            title={{concat this.contextLabel ": " this.activeContext.name}}
            class="{{concat "w-full " @buttonClass}} {{if this.isOpen "dd-is-open"}}"
            @wrapperClass={{concat "w-full " @buttonWrapperClass}}
            @size="xs"
            @type="primary"
            @icon={{if this.isNetworkContext "network-wired" "store"}}
            @iconSize="sm"
            @text={{this.activeContext.name}}
            @textClass="truncate"
            @onClick={{this.toggle}}
            data-test-store-selector-trigger
            data-context={{if this.isNetworkContext "network" "store"}}
        />
    </div>
{{else if (has-block)}}
    {{yield}}
{{/if}}
