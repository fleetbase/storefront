<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container space-y-4">
        <ContentPanel @title={{t "storefront.promotions.form.basics"}} @open={{true}} @wrapperClass="bordered-top">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                <InputGroup @name={{t "storefront.promotions.common.name"}} @value={{this.promotion.name}} @helpText={{t "storefront.promotions.form.name-help"}} @wrapperClass="md:col-span-2" />
                <InputGroup @name={{t "storefront.promotions.common.description"}} @helpText={{t "storefront.promotions.form.description-help"}} @wrapperClass="md:col-span-2">
                    <Textarea @value={{this.promotion.description}} class="form-input w-full" rows="2" />
                </InputGroup>
                <InputGroup @name={{t "storefront.promotions.list.type"}} @helpText={{t "storefront.promotions.form.type-help"}}>
                    <select class="form-select w-full" {{on "change" (fn this.setField "type")}}>
                        {{#each this.types as |type|}}
                            <option value={{type}} selected={{eq type this.promotion.type}}>{{t (concat "storefront.promotions.types." type)}}</option>
                        {{/each}}
                    </select>
                </InputGroup>
                <InputGroup @name={{t "storefront.promotions.list.trigger"}} @helpText={{t "storefront.promotions.form.trigger-help"}}>
                    <select class="form-select w-full" {{on "change" (fn this.setField "trigger")}}>
                        {{#each this.triggers as |trigger|}}
                            <option value={{trigger}} selected={{eq trigger this.promotion.trigger}}>{{t (concat "storefront.promotions.triggers." trigger)}}</option>
                        {{/each}}
                    </select>
                </InputGroup>

                {{#if (eq this.promotion.type "percentage")}}
                    <InputGroup @name={{t "storefront.promotions.form.percent-off"}}>
                        <Input @type="number" min="0" max="100" step="0.01" class="form-input w-full" @value={{this.promotion.value}} {{on "input" (fn this.setNumber "value")}} />
                    </InputGroup>
                {{else if (eq this.promotion.type "fixed_amount")}}
                    <InputGroup @name={{t "storefront.promotions.form.amount-off"}}>
                        <MoneyInput class="w-full" @currency={{@options.currency}} @value={{this.promotion.value}} @canSelectCurrency={{false}} @onChange={{fn this.setMoney "value"}} />
                    </InputGroup>
                {{else if (eq this.promotion.type "bogo")}}
                    <div class="md:col-span-2 grid grid-cols-3 gap-2">
                        <InputGroup @name={{t "storefront.promotions.form.buy-quantity"}}>
                            <Input @type="number" min="1" class="form-input w-full" @value={{this.bogo.buy_quantity}} {{on "input" (fn this.setBogo "buy_quantity")}} />
                        </InputGroup>
                        <InputGroup @name={{t "storefront.promotions.form.get-quantity"}}>
                            <Input @type="number" min="1" class="form-input w-full" @value={{this.bogo.get_quantity}} {{on "input" (fn this.setBogo "get_quantity")}} />
                        </InputGroup>
                        <InputGroup @name={{t "storefront.promotions.form.get-discount-percent"}}>
                            <Input @type="number" min="0" max="100" class="form-input w-full" @value={{this.bogo.discount_percent}} {{on "input" (fn this.setBogo "discount_percent")}} />
                        </InputGroup>
                        <p class="col-span-3 text-xs text-gray-500">{{t "storefront.promotions.form.bogo-help"}}</p>
                    </div>
                {{/if}}

                <InputGroup @name={{t "storefront.promotions.common.status"}}>
                    <select class="form-select w-full" {{on "change" (fn this.setField "status")}}>
                        {{#each this.statuses as |status|}}
                            <option value={{status}} selected={{eq status this.promotion.status}}>{{t (concat "storefront.promotions.statuses." status)}}</option>
                        {{/each}}
                    </select>
                </InputGroup>
            </div>
        </ContentPanel>

        <ContentPanel @title={{t "storefront.promotions.form.schedule"}} @open={{true}} @wrapperClass="bordered-top">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                <InputGroup @name={{t "storefront.promotions.form.starts-at"}}>
                    <DateTimeInput class="form-input w-full" @value={{this.promotion.starts_at}} @onUpdate={{fn (mut this.promotion.starts_at)}} />
                </InputGroup>
                <InputGroup @name={{t "storefront.promotions.form.ends-at"}}>
                    <DateTimeInput class="form-input w-full" @value={{this.promotion.ends_at}} @onUpdate={{fn (mut this.promotion.ends_at)}} />
                </InputGroup>
                <p class="md:col-span-2 text-xs text-gray-500">{{t "storefront.promotions.form.schedule-help"}}</p>
            </div>
        </ContentPanel>

        <ContentPanel @title={{t "storefront.promotions.form.conditions"}} @open={{false}} @wrapperClass="bordered-top">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                <InputGroup @name={{t "storefront.promotions.form.min-subtotal"}}>
                    <MoneyInput class="w-full" @currency={{@options.currency}} @value={{this.promotion.min_subtotal}} @canSelectCurrency={{false}} @onChange={{fn this.setMoney "min_subtotal"}} />
                </InputGroup>
                <InputGroup @name={{t "storefront.promotions.form.min-items"}}>
                    <Input @type="number" min="1" class="form-input w-full" @value={{this.promotion.min_items}} {{on "input" (fn this.setNumber "min_items")}} />
                </InputGroup>
                <div class="md:col-span-2">
                    <Toggle
                        @isToggled={{this.promotion.first_order_only}}
                        @onToggle={{fn (mut this.promotion.first_order_only)}}
                        @label={{t "storefront.promotions.form.first-order-only"}}
                        @helpText={{t "storefront.promotions.form.first-order-only-help"}}
                    />
                </div>
            </div>
        </ContentPanel>

        <ContentPanel @title={{t "storefront.promotions.form.targeting"}} @open={{false}} @wrapperClass="bordered-top">
            <p class="text-xs text-gray-500 mb-2">{{t "storefront.promotions.form.targeting-help"}}</p>
            <InputGroup @name={{t "storefront.promotions.form.products"}}>
                <ModelSelectMultiple
                    @modelName="product"
                    @query={{hash store_uuid=@options.storeId}}
                    @selectedModel={{this.products}}
                    @onChange={{fn this.setTargets "products" "products"}}
                    @triggerClass="form-select form-input w-full"
                    @renderInPlace={{true}}
                    @infiniteScroll={{false}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelectMultiple>
            </InputGroup>
            <InputGroup @name={{t "storefront.promotions.form.categories"}}>
                <ModelSelectMultiple
                    @modelName="category"
                    @query={{hash for="storefront_product" owner_uuid=@options.storeId}}
                    @selectedModel={{this.categories}}
                    @onChange={{fn this.setTargets "categories" "categories"}}
                    @triggerClass="form-select form-input w-full"
                    @renderInPlace={{true}}
                    @infiniteScroll={{false}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelectMultiple>
            </InputGroup>
            <InputGroup @name={{t "storefront.promotions.form.exclude-products"}}>
                <ModelSelectMultiple
                    @modelName="product"
                    @query={{hash store_uuid=@options.storeId}}
                    @selectedModel={{this.excludedProducts}}
                    @onChange={{fn this.setTargets "exclude_products" "excludedProducts"}}
                    @triggerClass="form-select form-input w-full"
                    @renderInPlace={{true}}
                    @infiniteScroll={{false}}
                    as |model|
                >
                    {{model.name}}
                </ModelSelectMultiple>
            </InputGroup>
        </ContentPanel>

        <ContentPanel @title={{t "storefront.promotions.form.limits"}} @open={{false}} @wrapperClass="bordered-top">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-2">
                <InputGroup @name={{t "storefront.promotions.form.usage-limit"}}>
                    <Input @type="number" min="1" class="form-input w-full" @value={{this.promotion.usage_limit}} {{on "input" (fn this.setNumber "usage_limit")}} />
                </InputGroup>
                <InputGroup @name={{t "storefront.promotions.form.usage-limit-per-customer"}}>
                    <Input @type="number" min="1" class="form-input w-full" @value={{this.promotion.usage_limit_per_customer}} {{on "input" (fn this.setNumber "usage_limit_per_customer")}} />
                </InputGroup>
                <InputGroup @name={{t "storefront.promotions.form.budget-amount"}}>
                    <MoneyInput class="w-full" @currency={{@options.currency}} @value={{this.promotion.budget_amount}} @canSelectCurrency={{false}} @onChange={{fn this.setMoney "budget_amount"}} />
                </InputGroup>
                <InputGroup @name={{t "storefront.promotions.form.max-discount-amount"}}>
                    <MoneyInput class="w-full" @currency={{@options.currency}} @value={{this.promotion.max_discount_amount}} @canSelectCurrency={{false}} @onChange={{fn this.setMoney "max_discount_amount"}} />
                </InputGroup>
                <p class="md:col-span-2 text-xs text-gray-500">{{t "storefront.promotions.form.limits-help"}}</p>
            </div>
        </ContentPanel>

        <ContentPanel @title={{t "storefront.promotions.form.stacking"}} @open={{false}} @wrapperClass="bordered-top">
            <div class="space-y-3">
                <Toggle
                    @isToggled={{this.promotion.stackable}}
                    @onToggle={{fn (mut this.promotion.stackable)}}
                    @label={{t "storefront.promotions.form.stackable"}}
                    @helpText={{t "storefront.promotions.form.stackable-help"}}
                />
                <InputGroup @name={{t "storefront.promotions.form.priority"}} @helpText={{t "storefront.promotions.form.priority-help"}}>
                    <Input @type="number" class="form-input w-full" @value={{this.promotion.priority}} {{on "input" (fn this.setNumber "priority")}} />
                </InputGroup>
                <Toggle @isToggled={{this.promotion.is_public}} @onToggle={{fn (mut this.promotion.is_public)}} @label={{t "storefront.promotions.form.is-public"}} />
            </div>
        </ContentPanel>
    </div>
</Modal::Default>
