<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <InputGroup @name={{t "storefront.component.modals.test-notification-channel.token"}} @helpText={{t "storefront.component.modals.test-notification-channel.token-text"}}>
            <Textarea class="form-input w-full" rows="3" @value={{@options.token}} {{on "blur" @options.setToken}} />
        </InputGroup>

        {{#if (eq @options.channel.scheme "apn")}}
            <InputGroup @name={{t "storefront.component.modals.test-notification-channel.environment"}} @helpText={{t "storefront.component.modals.test-notification-channel.environment-text"}}>
                <Select
                    class="w-full"
                    @options={{array "production" "sandbox"}}
                    @value={{@options.environment}}
                    @placeholder={{t "storefront.component.modals.test-notification-channel.environment"}}
                    @onSelect={{@options.setEnvironment}}
                    @humanize={{true}}
                />
            </InputGroup>
        {{/if}}

        {{#if @options.results}}
            <div class="p-2 rounded-md my-2 border border-gray-200 dark:border-gray-800">
                <h4 class="mb-2 font-semibold text-sm dark:text-white">{{t "storefront.component.modals.test-notification-channel.result"}}</h4>
                {{#each @options.results as |result|}}
                    <div class="text-xs font-mono dark:text-gray-200 mb-1">
                        {{#if result.environment}}[{{result.environment}}]{{/if}}
                        {{result.status}}
                        {{#if result.reason}}- {{result.reason}}{{/if}}
                    </div>
                {{/each}}
            </div>
        {{/if}}
    </div>
</Modal::Default>
