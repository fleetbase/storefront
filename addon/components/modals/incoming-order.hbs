<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="storefront-incoming-order" data-test-incoming-order>
        {{! The ticket: the store it came in at, when, and what it came to. }}
        <header class="storefront-incoming-order__hero">
            <div class="storefront-incoming-order__store">
                <Image src={{this.store.logo_url}} @fallbackSrc={{config "defaultValues.placeholderImage"}} alt={{this.store.name}} class="storefront-incoming-order__logo" />
                <div class="min-w-0">
                    <div class="storefront-incoming-order__store-name" data-test-incoming-order-store>{{n-a this.store.name}}</div>
                    <div class="storefront-incoming-order__muted">
                        {{t "storefront.component.modals.incoming-order.placed" ago=(n-a this.order.createdAgo)}}
                        · {{t "storefront.component.modals.incoming-order.items-count" count=this.itemCount}}
                    </div>
                </div>
            </div>
            <div class="storefront-incoming-order__amount">
                <div class="storefront-incoming-order__total" data-test-incoming-order-total>{{format-currency this.total this.currency}}</div>
                <div class="storefront-incoming-order__muted">
                    {{#if this.isCash}}
                        <FaIcon @icon="money-bill-wave" @size="xs" class="text-green-500" />
                        {{t "storefront.common.cash"}}
                    {{else}}
                        <FaIcon @icon="credit-card" @size="xs" />
                        {{n-a (titleize this.paymentLabel) (t "storefront.component.modals.incoming-order.paid-in-app")}}
                    {{/if}}
                </div>
            </div>
        </header>

        <div class="storefront-incoming-order__ref">
            <div class="min-w-0">
                <div class="storefront-incoming-order__tracking" data-test-incoming-order-tracking>{{or this.order.tracking this.order.public_id}}</div>
                {{#if this.order.tracking}}<div class="storefront-incoming-order__muted">{{this.order.public_id}}</div>{{/if}}
            </div>
            <div class="storefront-incoming-order__chips">
                <Badge @status={{this.order.status}} @size="xs" />
                <Badge @status={{if this.isPickup "info" "delivery"}} @text={{if this.isPickup (t "storefront.common.pickup") (t "storefront.common.delivery")}} @hideStatusDot={{true}} @size="xs" />
                <span class="storefront-incoming-order__chip" data-test-incoming-order-timing>
                    <FaIcon @icon={{if this.order.scheduled_at "calendar-day" "bolt"}} @size="xs" />
                    {{#if this.order.scheduled_at}}
                        {{t "storefront.component.modals.incoming-order.scheduled-for" date=(format-date-fns this.order.scheduled_at "d MMM, HH:mm")}}
                    {{else}}
                        {{t "storefront.order.asap"}}
                    {{/if}}
                </span>
            </div>
        </div>

        {{! Where it goes: from the store location to the customer, or the counter it is collected from. }}
        <section class="storefront-incoming-order__section">
            <div class="storefront-incoming-order__label">{{if this.isPickup (t "storefront.common.pickup") (t "storefront.common.delivery")}}</div>
            <ol class="storefront-incoming-order__route" data-test-incoming-order-route>
                <li class="storefront-incoming-order__stop">
                    <span class="storefront-incoming-order__stop-icon"><FaIcon @icon="store" @size="xs" /></span>
                    <div class="min-w-0">
                        <div class="storefront-incoming-order__stop-label">{{if this.isPickup (t "storefront.component.modals.incoming-order.collects-from") (t "storefront.component.modals.incoming-order.leaves-from")}}</div>
                        <div class="storefront-incoming-order__line" title={{this.pickup.address}}>
                            {{#if this.pickup.name}}<strong>{{this.pickup.name}}</strong> · {{/if}}{{n-a this.pickup.address}}
                        </div>
                    </div>
                </li>
                {{#unless this.isPickup}}
                    <li class="storefront-incoming-order__stop">
                        <span class="storefront-incoming-order__stop-icon storefront-incoming-order__stop-icon--dropoff"><FaIcon @icon="location-dot" @size="xs" /></span>
                        <div class="min-w-0">
                            <div class="storefront-incoming-order__stop-label">{{t "storefront.component.modals.incoming-order.deliver-to"}}</div>
                            <div class="storefront-incoming-order__line" title={{this.dropoff.address}}>
                                {{#if this.dropoff.name}}<strong>{{this.dropoff.name}}</strong> · {{/if}}{{n-a this.dropoff.address}}
                            </div>
                        </div>
                    </li>
                {{/unless}}
            </ol>
        </section>

        {{! Who it is for, and who takes it there. }}
        <section class="storefront-incoming-order__section storefront-incoming-order__people">
            <div class="min-w-0">
                <div class="storefront-incoming-order__label">{{t "storefront.common.customer"}}</div>
                <Customer::Pill @customer={{this.customer}} @subtitle={{null}} @titleFallback={{t "storefront.networks.orders.no-customer"}} @static={{not this.customer.id}} @size="xs" />
                {{#if this.customer.phone}}<div class="storefront-incoming-order__contact"><FaIcon @icon="phone" @size="xs" />{{this.customer.phone}}</div>{{/if}}
                {{#if this.customer.email}}<div class="storefront-incoming-order__contact" title={{this.customer.email}}><FaIcon @icon="envelope" @size="xs" />{{this.customer.email}}</div>{{/if}}
            </div>
            <div class="min-w-0">
                <div class="storefront-incoming-order__label">{{t "storefront.common.driver"}}</div>
                {{#if this.isPickup}}
                    <div class="storefront-incoming-order__muted">{{t "storefront.networks.orders.no-driver-needed"}}</div>
                {{else if this.driver}}
                    <Driver::Pill @driver={{this.driver}} @subtitle={{null}} @size="xs" />
                {{else}}
                    <div class="storefront-incoming-order__muted">{{t "storefront.component.modals.incoming-order.not-assigned"}}</div>
                {{/if}}
                {{#if (and @options.assignDriver (not this.isPickup))}}
                    <Button
                        @size="xs"
                        @icon="id-card"
                        @text={{if this.driver (t "storefront.component.modals.incoming-order.change-driver") (t "storefront.component.modals.incoming-order.assign-driver")}}
                        @onClick={{@options.assignDriver}}
                        @permission="storefront update order"
                        class="mt-2"
                        data-test-incoming-order-assign-driver
                    />
                {{/if}}
            </div>
        </section>

        {{#if this.order.notes}}
            <section class="storefront-incoming-order__section">
                <div class="storefront-incoming-order__label">{{t "storefront.component.modals.incoming-order.note"}}</div>
                <p class="storefront-incoming-order__note" data-test-incoming-order-note>{{this.order.notes}}</p>
            </section>
        {{/if}}

        {{! What is in it. }}
        <section class="storefront-incoming-order__section">
            <div class="storefront-incoming-order__label">{{t "storefront.component.modals.incoming-order.summary"}}</div>
            <Storefront::Order::LineItems @order={{this.order}} />
        </section>

        {{! The label codes, for printing or scanning at handover. }}
        {{#if (or this.qrCode this.barcode)}}
            <section class="storefront-incoming-order__section storefront-incoming-order__codes" data-test-incoming-order-codes>
                {{#if this.qrCode}}<img src={{this.qrCode}} alt={{t "storefront.component.modals.incoming-order.tracking"}} class="storefront-incoming-order__qr" />{{/if}}
                {{#if this.barcode}}<img src={{this.barcode}} alt={{t "storefront.component.modals.incoming-order.tracking"}} class="storefront-incoming-order__barcode" />{{/if}}
                <div class="storefront-incoming-order__muted">{{t "storefront.component.modals.incoming-order.scan-hint"}}</div>
            </section>
        {{/if}}
    </div>
</Modal::Default>
