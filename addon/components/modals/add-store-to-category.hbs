<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        {{#if @options.categories}}
            {{! Products: a store's own category tree. }}
            <Storefront::Product::CategoryTreeSelect
                @categories={{@options.categories}}
                @selected={{@options.category}}
                @placeholder={{t "storefront.products.bulk.pick-category"}}
                @onSelect={{@options.setCategory}}
            />
        {{else}}
            <NetworkCategoryPicker @network={{@options.network}} @onSelect={{@options.onSelectCategory}} @onCreateNewCategory={{@options.createNewCategory}} @wrapperClass="mr-2" />
        {{/if}}
    </div>
</Modal::Default>
