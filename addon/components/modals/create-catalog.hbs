<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container space-y-4">
        <p class="text-sm text-gray-500 dark:text-gray-400">{{t "storefront.catalogs.editor.create-lede"}}</p>
        <InputGroup @name={{t "storefront.common.name"}} @value={{@options.catalog.name}} @placeholder={{t "storefront.catalogs.editor.name-placeholder"}} @disabled={{cannot "storefront create catalog"}} />
        <InputGroup @name={{t "storefront.common.description"}} @value={{@options.catalog.description}} @disabled={{cannot "storefront create catalog"}} />
        <InputGroup @name={{t "storefront.common.status"}}>
            <Select class="w-full" @value={{@options.catalog.status}} @placeholder={{t "storefront.common.status"}} @options={{@options.statusOptions}} @onSelect={{fn (mut @options.catalog.status)}} @humanize={{true}} />
        </InputGroup>
    </div>
</Modal::Default>
