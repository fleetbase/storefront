<Modal::Default @modalIsOpened={{@modalIsOpened}} @options={{@options}} @confirm={{@onConfirm}} @decline={{@onDecline}}>
    <div class="modal-body-container">
        <p class="text-sm text-gray-600 dark:text-gray-400 mb-4">{{t "storefront.promotions.codes.help"}}</p>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-x-4">
            <InputGroup @name={{t "storefront.promotions.codes.count"}} as |inputId|>
                <Input id={{inputId}} @type="number" min="1" max="1000" step="1" placeholder="10" disabled={{or this.hasSpecificCode this.isGenerating}} class="form-input w-full" @value={{this.count}} {{on "input" (fn this.setValue "count")}} />
            </InputGroup>
            <InputGroup @name={{t "storefront.promotions.codes.prefix"}} as |inputId|>
                <Input id={{inputId}} class="form-input w-full uppercase" placeholder={{t "storefront.promotions.codes.prefix-placeholder"}} disabled={{or this.hasSpecificCode this.isGenerating}} @value={{this.prefix}} {{on "input" (fn this.setValue "prefix")}} />
            </InputGroup>
            <InputGroup @name={{t "storefront.promotions.codes.length"}} as |inputId|>
                <Input id={{inputId}} @type="number" min="6" max="16" step="1" placeholder="8" disabled={{or this.hasSpecificCode this.isGenerating}} class="form-input w-full" @value={{this.length}} {{on "input" (fn this.setValue "length")}} />
            </InputGroup>
            <InputGroup @name={{t "storefront.promotions.codes.usage-limit"}} @helpText={{t "storefront.promotions.codes.usage-limit-help"}} as |inputId|>
                <Input id={{inputId}} @type="number" min="1" step="1" placeholder={{t "storefront.promotions.form.no-limit"}} disabled={{this.isGenerating}} class="form-input w-full" @value={{this.usageLimit}} {{on "input" (fn this.setValue "usageLimit")}} />
            </InputGroup>
        </div>
        <InputGroup @name={{t "storefront.promotions.codes.specific-code"}} @helpText={{t "storefront.promotions.codes.specific-code-help"}} as |inputId|>
            <Input id={{inputId}} class="form-input w-full uppercase" placeholder={{t "storefront.promotions.codes.specific-code-placeholder"}} disabled={{this.isGenerating}} @value={{this.specificCode}} {{on "input" (fn this.setValue "specificCode")}} />
        </InputGroup>
        <div class="flex justify-end mb-4">
            <Button
                @type="primary"
                @icon="wand-magic-sparkles"
                @text={{t "storefront.promotions.codes.generate"}}
                @isLoading={{this.isGenerating}}
                @disabled={{or this.isGenerating this.isLoading}}
                @onClick={{this.generate}}
                @permission="storefront generate-codes promotion"
            />
        </div>

        <div class="border border-gray-200 rounded-md dark:border-gray-700 max-h-80 overflow-auto">
            <table class="w-full text-sm">
                <thead class="text-left text-xs uppercase text-gray-500 dark:text-gray-400 bg-gray-50 dark:bg-gray-800">
                    <tr>
                        <th class="px-3 py-2">{{t "storefront.promotions.codes.code"}}</th>
                        <th class="px-3 py-2">{{t "storefront.promotions.codes.used"}}</th>
                        <th class="px-3 py-2">{{t "storefront.promotions.common.status"}}</th>
                        <th class="px-3 py-2"><span class="sr-only">{{t "storefront.promotions.list.actions"}}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#if this.isLoading}}
                        <tr>
                            <td colspan="4" class="px-3 py-4"><Spinner @loadingMessage={{t "storefront.promotions.codes.loading"}} /></td>
                        </tr>
                    {{else if this.loadFailed}}
                        <tr>
                            <td colspan="4" class="px-3 py-4 text-center">
                                <p class="text-gray-500 dark:text-gray-400 mb-2">{{t "storefront.promotions.codes.load-failed"}}</p>
                                <Button @size="xs" @icon="rotate" @text={{t "storefront.promotions.codes.retry"}} @onClick={{this.loadCodes}} />
                            </td>
                        </tr>
                    {{else}}
                        {{#each this.codes as |code|}}
                            <tr class="border-t border-gray-200 dark:border-gray-700">
                                <td class="px-3 py-2 font-mono"><ClickToCopy @value={{code.code}}>{{code.code}}</ClickToCopy></td>
                                <td class="px-3 py-2">{{code.times_used}}{{#if code.usage_limit}} / {{code.usage_limit}}{{/if}}</td>
                                <td class="px-3 py-2"><Badge @status={{code.status}} @hideStatusDot={{true}} /></td>
                                <td class="px-3 py-2 text-right">
                                    <Button
                                        @size="xs"
                                        @text={{if (eq code.status "active") (t "storefront.promotions.codes.disable") (t "storefront.promotions.codes.enable")}}
                                        @isLoading={{code.isSaving}}
                                        @disabled={{code.isSaving}}
                                        @onClick={{fn this.toggleCode code}}
                                        @permission="storefront update promotion-code"
                                    />
                                </td>
                            </tr>
                        {{else}}
                            <tr>
                                <td colspan="4" class="px-3 py-4 text-center text-gray-500 dark:text-gray-400">{{t "storefront.promotions.codes.empty"}}</td>
                            </tr>
                        {{/each}}
                    {{/if}}
                </tbody>
            </table>
        </div>
    </div>
</Modal::Default>
