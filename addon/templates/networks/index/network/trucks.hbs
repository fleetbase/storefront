<Storefront::PageHeader @title={{t "storefront.common.food-trucks"}} @subtitle={{t "storefront.trucks.network.subtitle"}} @searchQuery={{this.query}} @onSearch={{perform this.search}} @searchPlaceholder={{t "storefront.trucks.index.search"}} data-test-trucks-header>
    <Button @size="sm" @icon="map" @text={{t "storefront.trucks.index.map"}} class={{if this.isMapView "storefront-filter-button is-active" "storefront-filter-button"}} @onClick={{this.toggleMapView}} data-test-trucks-map />
    <Button @type="primary" @size="sm" @icon="plus" @text={{t "storefront.trucks.index.new-truck"}} @onClick={{this.createFoodTruck}} @permission="storefront create food-truck" data-test-trucks-new />
</Storefront::PageHeader>

<Layout::Section::Body class="overflow-y-scroll-i h-full">
    <div class="storefront-status-tabs px-5 pt-4" role="tablist" data-test-truck-status-tabs>
        {{#each this.statusTabs as |tab|}}
            <button type="button" role="tab" aria-selected={{if tab.isActive "true" "false"}} class="storefront-status-tab {{if tab.isActive 'is-active'}}" {{on "click" (fn this.selectStatusTab tab)}} data-test-status-tab={{tab.id}}>
                <span>{{tab.label}}</span>
                <span class="storefront-status-tab__count">{{tab.count}}</span>
            </button>
        {{/each}}
    </div>
    {{#if this.isMapView}}
        <div class="storefront-page storefront-truck-map-page" data-test-trucks-map-view>
            <Storefront::Truck::Map @trucks={{this.mappableTrucks}} @onSelect={{this.editFoodTruck}} @height="100%" class="storefront-truck-map--page" />
            <p class="storefront-table-card__note">{{t "storefront.trucks.index.map-note" count=this.mappableTrucks.length total=this.visibleTrucks.length}}</p>
        </div>
    {{else}}
        <Layout::Resource::CardsGrid
            @resource="truck"
            @data={{this.visibleTrucks}}
            @columns="4"
            @containerClass="p-5"
            @emptyStateText={{t "storefront.networks.index.network.trucks.empty-state"}}
            @createButtonText={{t "storefront.trucks.index.new-truck"}}
            @onCreateNew={{this.createFoodTruck}}
            class="h-full"
            as |Item|
        >
            <Storefront::Truck::Card @truck={{Item.model}} @onEdit={{this.editFoodTruck}} @onAssignCatalogs={{this.assignCatalogs}} @onOpenVehicle={{this.openVehicle}} @onDelete={{this.deleteFoodTruck}} />
        </Layout::Resource::CardsGrid>
    {{/if}}
</Layout::Section::Body>

{{#if this.activeTruck}}
    <Storefront::Truck::Panel @truck={{this.activeTruck}} @tab={{this.panelTab}} @catalogs={{this.catalogs}} @onClose={{this.closeTruckPanel}} @onSaved={{this.onTruckSaved}} @onDelete={{this.deleteFoodTruck}} @onViewOrder={{this.viewOrder}} />
{{/if}}
