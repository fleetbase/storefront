<Layout::Section::Header @title={{t "storefront.networks.index.network.overview"}}>
    <Button @icon="store" @text={{t "storefront.networks.index.network.stores.store"}} @size="sm" @onClick={{this.manageStores}} @wrapperClass="mr-2" />
    <Button @icon="cog" @text={{t "storefront.networks.index.network.settings"}} @size="sm" @onClick={{this.openSettings}} @wrapperClass="mr-2" @permission="storefront update network" />
    <Button @type="primary" @icon="envelope-open-text" @text={{t "storefront.networks.invitations.invite-stores"}} @size="sm" @onClick={{fn this.openInvitePanel "email"}} @permission="storefront update network" />
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll-i h-full">
    <div class="storefront-network-overview p-4 space-y-4" data-test-network-overview>
        <div class="storefront-stat-grid">
            <div class="storefront-stat-tile" data-test-stat="stores">
                <div class="storefront-stat-tile__label">{{t "storefront.networks.index.network.stores.store"}}</div>
                <div class="storefront-stat-tile__value">{{this.overview.stores.total}}</div>
                <div class="storefront-stat-tile__hint">{{t "storefront.networks.overview.online-count" count=this.overview.stores.online}}</div>
            </div>
            <div class="storefront-stat-tile" data-test-stat="invitations">
                <div class="storefront-stat-tile__label">{{t "storefront.networks.invitations.title"}}</div>
                <div class="storefront-stat-tile__value">{{this.pendingCount}}</div>
                <div class="storefront-stat-tile__hint">{{t "storefront.networks.overview.invitations-hint" declined=this.declinedCount}}</div>
            </div>
            <div class="storefront-stat-tile" data-test-stat="orders">
                <div class="storefront-stat-tile__label">{{t "storefront.networks.overview.orders-7d"}}</div>
                <div class="storefront-stat-tile__value">{{this.overview.orders.count_7d}}</div>
                <div class="storefront-stat-tile__hint">{{t "storefront.networks.overview.multi-store-count" count=this.overview.orders.multi_store_7d}}</div>
            </div>
            <div class="storefront-stat-tile" data-test-stat="revenue">
                <div class="storefront-stat-tile__label">{{t "storefront.networks.overview.revenue-7d"}}</div>
                <div class="storefront-stat-tile__value">{{format-currency this.overview.revenue.total_7d this.currency}}</div>
                <div class="storefront-stat-tile__hint">{{t "storefront.networks.overview.tips-hint" tips=(format-currency this.overview.revenue.tips_7d this.currency)}}</div>
            </div>
            <div class="storefront-stat-tile" data-test-stat="customers">
                <div class="storefront-stat-tile__label">{{t "storefront.common.customers"}}</div>
                <div class="storefront-stat-tile__value">{{this.overview.customers.total}}</div>
                <div class="storefront-stat-tile__hint">{{t "storefront.networks.overview.new-customers" count=this.overview.customers.new_this_month}}</div>
            </div>
        </div>

        <ContentPanel @title={{t "storefront.networks.overview.members-title" count=this.members.length}} @open={{true}} @pad={{false}} @wrapperClass="bordered-top" @panelBodyClass="p-0" @actionButtons={{array (hash type="link" size="xs" text=(t "storefront.networks.overview.manage-stores") onClick=this.manageStores)}}>
            {{#if this.members.length}}
                <Layout::Resource::CardsGrid @resource="store" @data={{this.memberRows}} @columns="4" @containerClass="p-4" @showPagination={{false}} class="storefront-member-cards" as |Item|>
                    <Layout::Resource::Card class="storefront-card storefront-member-card" data-test-member-row={{Item.model.member.public_id}} as |Card|>
                        <Card.header>
                            <div class="storefront-card__title">
                                <span class="storefront-card__title-text">{{Item.model.member.name}}</span>
                                <FaIcon @icon="circle" @size="xs" class="storefront-card__indicator {{if Item.model.member.online 'text-green-500' 'text-gray-400'}}" />
                            </div>
                            <div class="storefront-card__subtitle">{{if Item.model.member.category Item.model.member.category (t "storefront.networks.overview.no-category")}}</div>
                        </Card.header>
                        <Card.body class="storefront-card__media-body">
                            <Image src={{Item.model.member.logo_url}} @fallbackSrc={{config "defaultValues.placeholderImage"}} alt={{Item.model.member.name}} class="storefront-card__media storefront-card__media--contain" />
                        </Card.body>
                        <Card.footer>
                            <div class="storefront-card__actions">
                                <Badge @status={{Item.model.badgeStatus}} @text={{Item.model.badgeLabel}} @size="xs" />
                                <div class="storefront-card__buttons">
                                    <Button @icon="table-list" @size="xs" @helpText={{t "storefront.networks.overview.view-on-stores"}} @onClick={{fn this.viewMember Item.model.member}} data-test-member-view />
                                    {{#if Item.model.ownStore}}
                                        <Button @icon="arrow-right-to-bracket" @size="xs" @helpText={{t "storefront.networks.overview.open-store"}} @onClick={{fn this.openMemberStore Item.model.ownStore}} data-test-member-open />
                                    {{/if}}
                                </div>
                            </div>
                            <div class="storefront-card__meta">
                                <span>{{t "storefront.networks.overview.orders-count-7d" count=Item.model.member.orders_7d}}</span>
                                <span>{{format-currency Item.model.member.revenue_7d this.currency}} · {{t "storefront.networks.overview.share-of-network" share=Item.model.member.share}}</span>
                            </div>
                        </Card.footer>
                    </Layout::Resource::Card>
                </Layout::Resource::CardsGrid>
            {{else}}
                <div class="storefront-empty-row">
                    <span>{{t "storefront.networks.overview.no-members"}}</span>
                    <Button @size="xs" @icon="envelope-open-text" @text={{t "storefront.networks.invitations.invite-stores"}} @onClick={{fn this.openInvitePanel "email"}} />
                </div>
            {{/if}}
        </ContentPanel>

        <ContentPanel @title={{t "storefront.networks.invitations.title"}} @open={{true}} @pad={{false}} @wrapperClass="bordered-top" @panelBodyClass="p-0">
            {{#if this.openInvitations.length}}
                <div class="storefront-member-list">
                    {{#each this.openInvitations as |invitation|}}
                        <div class="storefront-member-row" data-test-invitation-row={{invitation.id}}>
                            <div class="storefront-member-row__logo storefront-member-row__logo--icon"><FaIcon @icon="at" /></div>
                            <div class="storefront-member-row__identity">
                                <div class="storefront-member-row__name">{{invitation.email}}</div>
                                <div class="storefront-member-row__meta">{{t "storefront.networks.invitations.sent-ago" ago=invitation.sentAgo}}</div>
                            </div>
                            <Badge @status={{invitation.status}} @text={{t (concat "storefront.networks.invitations.status." invitation.status)}} @size="xs" />
                            <div class="storefront-card__buttons">
                                {{#if (eq invitation.status "pending")}}
                                    <Button @size="xs" @icon="paper-plane" @text={{t "storefront.networks.invitations.resend"}} @onClick={{fn this.resendInvitation invitation}} @permission="storefront update network" />
                                    <Button @size="xs" @icon="ban" @helpText={{t "storefront.networks.invitations.revoke"}} @onClick={{fn this.revokeInvitation invitation}} @permission="storefront update network" />
                                {{else}}
                                    <Button @size="xs" @icon="redo" @text={{t "storefront.networks.invitations.invite-again"}} @onClick={{fn this.resendInvitation invitation}} @permission="storefront update network" />
                                {{/if}}
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <div class="storefront-empty-row">
                    <span>{{t "storefront.networks.invitations.none"}}</span>
                    <Button @size="xs" @icon="envelope-open-text" @text={{t "storefront.networks.invitations.invite-stores"}} @onClick={{fn this.openInvitePanel "email"}} />
                </div>
            {{/if}}
            <div class="storefront-member-row storefront-member-row--link">
                <div class="storefront-member-row__logo storefront-member-row__logo--icon"><FaIcon @icon="link" /></div>
                <div class="storefront-member-row__identity">
                    <div class="storefront-member-row__name">{{t "storefront.networks.invitations.shareable-link"}}</div>
                    <div class="storefront-member-row__meta">{{if this.shareableLinkEnabled (t "storefront.common.on") (t "storefront.common.off")}}</div>
                </div>
                {{#if this.shareableLinkEnabled}}
                    <ClickToCopy @value={{this.shareableLink}} class="storefront-member-row__link truncate" />
                {{/if}}
                <Button @size="xs" @icon="cog" @text={{t "storefront.networks.invitations.manage-link"}} @onClick={{fn this.openInvitePanel "link"}} />
            </div>
        </ContentPanel>

        <ContentPanel @title={{t "storefront.networks.overview.recent-orders"}} @open={{true}} @pad={{false}} @wrapperClass="bordered-top" @panelBodyClass="p-0" @actionButtons={{array (hash type="link" text=(t "storefront.networks.overview.all-orders") onClick=this.viewOrders size="xs")}}>
            {{#if this.recentOrders.length}}
                <div class="storefront-member-list">
                    {{#each this.recentOrders as |order|}}
                        <div class="storefront-member-row" data-test-recent-order={{order.public_id}}>
                            <div class="storefront-member-row__identity">
                                <div class="storefront-member-row__name">{{order.public_id}}</div>
                                <div class="storefront-member-row__meta">{{n-a order.customer_name}} · {{n-a order.store_name}}</div>
                            </div>
                            <div class="storefront-member-row__amount">{{format-currency order.total order.currency}}</div>
                            <Badge @status={{order.status}} @size="xs" />
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <div class="storefront-empty-row"><span>{{t "storefront.networks.overview.no-orders"}}</span></div>
            {{/if}}
        </ContentPanel>
    </div>
</Layout::Section::Body>

{{#if this.isInvitePanelOpen}}
    <Storefront::Network::InvitePanel @network={{this.network}} @activeTab={{this.invitePanelTab}} @onClose={{this.closeInvitePanel}} @onSent={{this.refresh}} />
{{/if}}
