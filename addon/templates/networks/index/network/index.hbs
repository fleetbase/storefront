<Storefront::PageHeader
    @title={{this.network.name}}
    @imageUrl={{this.network.logo_url}}
    @badgeStatus={{if this.network.online "online" "offline"}}
    @badgeText={{if this.network.online (t "storefront.common.online") (t "storefront.common.offline")}}
    @subtitle={{this.headerMeta}}
    data-test-network-overview-header
>
    <Button @icon="cog" @text={{t "storefront.networks.index.network.settings"}} @size="sm" @onClick={{this.openSettings}} @permission="storefront update network" />
    <Button @type="primary" @icon="envelope-open-text" @text={{t "storefront.networks.invitations.invite-stores"}} @size="sm" @onClick={{fn this.openInvitePanel "email"}} @permission="storefront update network" />
</Storefront::PageHeader>

<Layout::Section::Body class="overflow-y-scroll-i h-full">
    <div class="storefront-page storefront-network-overview" data-test-network-overview>
        <div class="storefront-stat-grid">
            <div class="storefront-stat-tile" data-test-stat="stores">
                <div class="storefront-stat-tile__label">{{t "storefront.networks.index.network.stores.store"}}</div>
                <div class="storefront-stat-tile__value">{{this.overview.stores.total}}</div>
                <div class="storefront-stat-tile__hint">{{t "storefront.networks.overview.online-count" count=this.overview.stores.online}}</div>
            </div>
            <div class="storefront-stat-tile" data-test-stat="invitations">
                <div class="storefront-stat-tile__label">{{t "storefront.networks.invitations.title"}}</div>
                <div class="storefront-stat-tile__value">{{this.pendingCount}}</div>
                <div class="storefront-stat-tile__hint">{{t "storefront.networks.overview.invitations-hint" declined=this.declinedCount}}</div>
            </div>
            <div class="storefront-stat-tile" data-test-stat="orders">
                <div class="storefront-stat-tile__label">{{t "storefront.networks.overview.orders-7d"}}</div>
                <div class="storefront-stat-tile__value">{{this.overview.orders.count_7d}}</div>
                <div class="storefront-stat-tile__hint">{{t "storefront.networks.overview.multi-store-count" count=this.overview.orders.multi_store_7d}}</div>
            </div>
            <div class="storefront-stat-tile" data-test-stat="revenue">
                <div class="storefront-stat-tile__label">{{t "storefront.networks.overview.revenue-7d"}}</div>
                <div class="storefront-stat-tile__value">{{format-currency this.overview.revenue.total_7d this.currency}}</div>
                <div class="storefront-stat-tile__hint">{{t "storefront.networks.overview.tips-hint" tips=(format-currency this.overview.revenue.tips_7d this.currency)}}</div>
            </div>
            <div class="storefront-stat-tile" data-test-stat="customers">
                <div class="storefront-stat-tile__label">{{t "storefront.common.customers"}}</div>
                <div class="storefront-stat-tile__value">{{this.overview.customers.total}}</div>
                <div class="storefront-stat-tile__hint">{{t "storefront.networks.overview.new-customers" count=this.overview.customers.new_this_month}}</div>
            </div>
        </div>

        <Storefront::SectionCard @id="members" @title={{t "storefront.networks.index.network.stores.store"}} @subtitle={{t "storefront.networks.overview.members-count" count=this.members.length}} @plain={{true}}>
            <:actions><a href="javascript:;" class="storefront-section-card__link" {{on "click" this.manageStores}}>{{t "storefront.networks.overview.manage-stores"}}</a></:actions>
            <:default>
            {{#if this.members.length}}
                <div class="storefront-member-cards" data-test-member-cards>
                    {{#each this.memberRows as |row|}}
                        <Layout::Resource::Card class="storefront-card storefront-member-card" data-test-member-row={{row.member.public_id}} as |Card|>
                            <Card.header>
                                <Store::Pill @store={{row.member}} @subtitle={{if row.member.category row.member.category (t "storefront.networks.overview.no-category")}} @showOnlineIndicator={{true}} @static={{true}} class="storefront-card__identity" data-test-member-pill />
                            </Card.header>
                            <Card.body class="storefront-card__media-body">
                                <Image src={{row.member.logo_url}} @fallbackSrc={{config "defaultValues.placeholderImage"}} alt={{row.member.name}} class="storefront-card__media storefront-card__media--contain" />
                            </Card.body>
                            <Card.footer>
                                <div class="storefront-card__actions">
                                    <Badge @status={{row.badgeStatus}} @text={{row.badgeLabel}} @size="xs" />
                                    <div class="storefront-card__buttons">
                                        <DropdownButton @icon="ellipsis-h" @size="xs" @iconPrefix="fas" @renderInPlace={{false}} @helpText={{t "storefront.common.actions"}} data-test-member-menu as |dd|>
                                            <div class="next-dd-menu mt-1 mx-0">
                                                <div class="px-1">
                                                    <a href="javascript:;" class="next-dd-item" {{on "click" (dropdown-fn dd this.viewMember row.member)}}><FaIcon @icon="table-list" class="mr-2" />{{t "storefront.networks.overview.view-on-stores"}}</a>
                                                    {{#if row.ownStore}}
                                                        <a href="javascript:;" class="next-dd-item" {{on "click" (dropdown-fn dd this.openMemberStore row.ownStore)}}><FaIcon @icon="arrow-right-to-bracket" class="mr-2" />{{t "storefront.networks.overview.open-store"}}</a>
                                                    {{/if}}
                                                </div>
                                            </div>
                                        </DropdownButton>
                                    </div>
                                </div>
                                <div class="storefront-card__meta">
                                    <span>{{t "storefront.networks.overview.orders-count-7d" count=row.member.orders_7d}}</span>
                                    <span>{{format-currency row.member.revenue_7d this.currency}} · {{t "storefront.networks.overview.share-of-network" share=row.member.share}}</span>
                                </div>
                            </Card.footer>
                        </Layout::Resource::Card>
                    {{/each}}
                </div>
            {{else}}
                <div class="storefront-empty-row">
                    <span>{{t "storefront.networks.overview.no-members"}}</span>
                    <Button @size="xs" @icon="envelope-open-text" @text={{t "storefront.networks.invitations.invite-stores"}} @onClick={{fn this.openInvitePanel "email"}} />
                </div>
            {{/if}}
            </:default>
        </Storefront::SectionCard>

        <Storefront::SectionCard @id="invitations" @title={{t "storefront.networks.invitations.title"}}>
            <:actions><a href="javascript:;" class="storefront-section-card__link" {{on "click" (fn this.openInvitePanel "email")}}>{{t "storefront.networks.invitations.invite-stores"}}</a></:actions>
            <:default>
            <table class="storefront-table" data-test-invitations-table>
                <thead>
                    <tr>
                        <th>{{t "storefront.networks.overview.invitee"}}</th>
                        <th>{{t "storefront.networks.overview.sent"}}</th>
                        <th>{{t "storefront.networks.overview.state"}}</th>
                        <th class="text-right"><span class="sr-only">{{t "storefront.common.actions"}}</span></th>
                    </tr>
                </thead>
                <tbody>
                    {{#each this.openInvitations as |invitation|}}
                        <tr data-test-invitation-row={{invitation.id}}>
                            <td><div class="storefront-table__identity"><span class="storefront-table__tile"><FaIcon @icon="at" @size="xs" /></span><span class="truncate">{{or invitation.email invitation.store_name}}</span></div></td>
                            <td class="storefront-table__muted">{{invitation.sentAgo}}</td>
                            <td><Badge @status={{invitation.status}} @text={{t (concat "storefront.networks.invitations.status." invitation.status)}} @size="xs" /></td>
                            <td class="text-right">
                                {{#if (eq invitation.status "pending")}}
                                    <Button @size="xs" @text={{t "storefront.networks.invitations.resend"}} @onClick={{fn this.resendInvitation invitation}} @permission="storefront update network" />
                                    <Button @size="xs" @icon="ban" @helpText={{t "storefront.networks.invitations.revoke"}} @onClick={{fn this.revokeInvitation invitation}} @permission="storefront update network" />
                                {{else}}
                                    <Button @size="xs" @text={{t "storefront.networks.invitations.invite-again"}} @onClick={{fn this.resendInvitation invitation}} @permission="storefront update network" />
                                {{/if}}
                            </td>
                        </tr>
                    {{else}}
                        <tr><td colspan="4" class="storefront-table__muted">{{t "storefront.networks.invitations.none"}}</td></tr>
                    {{/each}}
                    <tr data-test-shareable-link-row>
                        <td><div class="storefront-table__identity"><span class="storefront-table__tile"><FaIcon @icon="link" @size="xs" /></span><span>{{t "storefront.networks.invitations.shareable-link"}}</span></div></td>
                        <td class="storefront-table__muted">{{if this.shareableLinkEnabled (t "storefront.common.on") (t "storefront.common.off")}}</td>
                        <td>{{#if this.shareableLinkEnabled}}<span class="storefront-table__muted">{{t "storefront.networks.invitations.link-joins" count=this.linkJoins}}</span>{{/if}}</td>
                        <td class="text-right">
                            {{#if this.shareableLinkEnabled}}<ClickToCopy @value={{this.shareableLink}} class="storefront-table__copy">{{t "storefront.networks.overview.copy-link"}}</ClickToCopy>{{/if}}
                            <Button @size="xs" @icon="cog" @helpText={{t "storefront.networks.invitations.manage-link"}} @onClick={{fn this.openInvitePanel "link"}} />
                        </td>
                    </tr>
                </tbody>
            </table>
            </:default>
        </Storefront::SectionCard>

        <Storefront::SectionCard @id="recent-orders" @title={{t "storefront.networks.overview.recent-orders"}}>
            <:actions><a href="javascript:;" class="storefront-section-card__link" {{on "click" this.viewOrders}}>{{t "storefront.networks.overview.all-orders"}}</a></:actions>
            <:default>
            <table class="storefront-table storefront-table--rows" data-test-recent-orders-table>
                <thead>
                    <tr>
                        <th>{{t "storefront.common.order"}}</th>
                        <th>{{t "storefront.common.customer"}}</th>
                        <th>{{t "storefront.common.store"}}</th>
                        <th>{{t "storefront.networks.orders.columns.placed"}}</th>
                        <th>{{t "storefront.common.status"}}</th>
                        <th class="is-right">{{t "storefront.common.total"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each this.recentOrders as |order|}}
                        <tr class="is-clickable" {{on "click" (fn this.viewOrder order)}} data-test-recent-order={{order.public_id}}>
                            <td><a href="javascript:;" class="storefront-table__link">{{order.public_id}}</a></td>
                            <td><Customer::Pill @customer={{hash id=order.customer_id public_id=order.customer_id name=order.customer_name photo_url=order.customer_photo_url}} @title={{order.customer_name}} @subtitle={{null}} @static={{true}} @noTooltip={{true}} /></td>
                            <td><Store::Pill @store={{hash id=order.store_id public_id=order.store_id name=order.store_name logo_url=order.store_logo_url}} @title={{order.store_name}} @subtitle={{null}} @static={{true}} @noTooltip={{true}} /></td>
                            <td class="storefront-table__muted">{{format-date-fns order.created_at "d MMM, HH:mm"}}</td>
                            <td><Badge @status={{order.status}} @size="xs" /></td>
                            <td class="is-right font-semibold">{{format-currency order.total order.currency}}</td>
                        </tr>
                    {{else}}
                        <tr><td colspan="6" class="storefront-table__muted">{{t "storefront.networks.overview.no-orders"}}</td></tr>
                    {{/each}}
                </tbody>
            </table>
            </:default>
        </Storefront::SectionCard>
    </div>
</Layout::Section::Body>

{{#if this.isInvitePanelOpen}}
    <Storefront::Network::InvitePanel @network={{this.network}} @activeTab={{this.invitePanelTab}} @onClose={{this.closeInvitePanel}} @onSent={{this.refresh}} />
{{/if}}
