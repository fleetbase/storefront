<Layout::Section::Header @title={{t "storefront.common.orders"}} @searchQuery={{this.query}} @onSearch={{perform this.search}}>
    <Storefront::ViewToggle @options={{array (hash id="grouped" label=(t "storefront.networks.orders.group-by-checkout")) (hash id="flat" label=(t "storefront.networks.orders.flat"))}} @value={{if this.isGrouped "grouped" "flat"}} @onChange={{this.setView}} @wrapperClass="mr-2" data-test-order-view-toggle />
    <Button @type="primary" @size="sm" @icon="plus" @text={{t "storefront.orders.create.title"}} @onClick={{this.createOrder}} @permission="storefront create order" class="ml-2" data-test-network-new-order />
    <Layout::Resource::ActionButtons @buttons={{this.registeredActionButtons}} />
</Layout::Section::Header>

{{outlet}}

<Layout::Section::Body class="overflow-y-scroll-i h-full">
    <div class="storefront-status-tabs px-4 pt-3" role="tablist" data-test-order-status-tabs>
        {{#each this.statusTabs as |tab|}}
            <button type="button" role="tab" aria-selected={{if tab.isActive "true" "false"}} class="storefront-status-tab {{if tab.isActive 'is-active'}}" {{on "click" (fn this.selectStatusTab tab)}} data-test-status-tab={{tab.id}}>
                {{tab.label}}
            </button>
        {{/each}}
    </div>

    {{#if this.isGrouped}}
        <Table
            @wrapperClass="overscroll-y-none storefront-network-orders-table"
            @rows={{this.rows}}
            @columns={{this.registeredColumns}}
            @canExpand={{true}}
            @onSetup={{fn (mut this.table)}}
            @pagination={{true}}
            @paginationMeta={{@model.meta}}
            @page={{this.page}}
            @onPageChange={{fn (mut this.page)}}
            as |t|
        >
            <t.head />
            <t.body as |b|>
                <b.expanded-row as |group|>
                    {{#if group.isGroup}}
                        <div class="storefront-order-group" data-test-order-group={{group.id}}>
                            {{#each group.orders as |order|}}
                                <div class="storefront-order-group__row">
                                    {{#each t.columns as |column|}}
                                        <div class="storefront-order-group__cell" style={{width-style-px column.width}}>
                                            {{#if column.cellComponent}}
                                                {{component column.cellComponent row=order column=column value=(get order column.valuePath)}}
                                            {{else}}
                                                {{get order column.valuePath}}
                                            {{/if}}
                                        </div>
                                    {{/each}}
                                </div>
                            {{/each}}
                        </div>
                    {{/if}}
                </b.expanded-row>
            </t.body>
        </Table>
    {{else}}
        <Table
            @wrapperClass="overscroll-y-none storefront-network-orders-table"
            @rows={{this.rows}}
            @columns={{this.registeredColumns}}
            @onSetup={{fn (mut this.table)}}
            @pagination={{true}}
            @paginationMeta={{@model.meta}}
            @page={{this.page}}
            @onPageChange={{fn (mut this.page)}}
        />
    {{/if}}
    <p class="storefront-invitation-list__note px-4">{{t "storefront.networks.orders.group-note"}}</p>
</Layout::Section::Body>
