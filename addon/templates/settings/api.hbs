<div class="storefront-settings-page" data-test-settings-api>
    <section class="storefront-settings-section">
        <ContentPanel @title={{t "storefront.settings.sections.api-keys"}} @open={{true}} @pad={{false}} @wrapperClass="bordered-classic">
            <p class="storefront-settings-section__lede">{{t "storefront.settings.api.access-key-for-storefront-api-integrations"}}</p>
            <InputGroup @name={{t "storefront.settings.api.store-key"}} @helpText={{t "storefront.settings.api.store-key-help-text"}} @wrapperClass="mb-0">
                <ClickToReveal @value={{@model.key}} @clickToCopy={{true}} class="form-input disabled" />
            </InputGroup>
        </ContentPanel>
    </section>
    <Spacer @height="120px" />
</div>
