<form class="storefront-settings-page" {{on "submit" this.saveSettings}} {{on "input" this.touch}} {{on "change" this.touch}} data-test-store-settings>
    <section id="settings-general" class="storefront-settings-section" data-test-settings-section="general">
        <ContentPanel @title={{t "storefront.common.general"}} @open={{true}} @pad={{false}} @wrapperClass="bordered-classic">
            <p class="storefront-settings-section__lede">{{t "storefront.settings.index.general-settings-message"}}</p>
            <div class="storefront-settings-grid">
                <InputGroup
                    @id="storefront_name_input"
                    @name={{t "storefront.common.name"}}
                    @value={{@model.name}}
                    @placeholder={{t "storefront.settings.index.name-placeholder"}}
                    @helpText={{t "storefront.settings.index.name-help-text"}}
                />
                <InputGroup @name={{t "storefront.settings.sections.store-key"}} @helpText={{t "storefront.settings.sections.store-key-help"}}>
                    <ClickToCopy @value={{@model.key}} class="form-input w-full truncate storefront-settings-readonly">{{n-a @model.key}}</ClickToCopy>
                </InputGroup>
                <InputGroup @name={{t "storefront.common.currency"}}>
                    <CurrencySelect @currency={{@model.currency}} @onCurrencyChange={{fn (mut @model.currency)}} @triggerClass="w-full form-select" />
                </InputGroup>
                <InputGroup @name={{t "storefront.settings.sections.default-order-config"}} @helpText={{t "storefront.settings.sections.default-order-config-help"}}>
                    <Select
                        @value={{@model.order_config_uuid}}
                        @options={{this.orderConfigs}}
                        @optionValue="id"
                        @optionLabel="name"
                        @onSelect={{fn (mut @model.order_config_uuid)}}
                        @placeholder={{t "storefront.settings.sections.default-order-config-placeholder"}}
                        class="w-full"
                    />
                </InputGroup>
            </div>
            <InputGroup
                @name={{t "storefront.common.description"}}
                @value={{@model.description}}
                @placeholder={{t "storefront.settings.index.description-placeholder"}}
                @helpText={{t "storefront.settings.index.description-help-text"}}
            />
            <InputGroup @name={{t "storefront.common.tag"}}>
                <TagInput
                    class="form-input"
                    @placeholder={{t "storefront.settings.index.tags-placeholder"}}
                    @allowSpacesInTags={{true}}
                    @tags={{@model.tags}}
                    @addTag={{this.addTag}}
                    @removeTagAtIndex={{this.removeTag}}
                    as |tag|
                >
                    {{tag}}
                </TagInput>
            </InputGroup>
            <ContentPanel @title={{t "storefront.settings.index.contact-social"}} @open={{false}} @pad={{false}} @wrapperClass="bordered-top">
            <InputGroup @name={{t "storefront.common.phone"}}>
                <PhoneInput @value={{@model.phone}} @onInput={{fn (mut @model.phone)}} class="form-input w-full" />
            </InputGroup>
            <InputGroup
                @name={{t "storefront.common.website"}}
                @value={{@model.website}}
                @placeholder={{t "storefront.common.website"}}
                @helpText={{t "storefront.settings.index.website-help-text"}}
            />
            <InputGroup
                @name={{t "storefront.common.facebook"}}
                @value={{@model.facebook}}
                @placeholder={{t "storefront.settings.index.facebook-placeholder"}}
                @helpText={{t "storefront.settings.index.facebook-help-text"}}
            />
            <InputGroup
                @name={{t "storefront.common.instagram"}}
                @value={{@model.instagram}}
                @placeholder={{t "storefront.settings.index.instagram-placeholder"}}
                @helpText={{t "storefront.settings.index.instagram-help-text"}}
            />
            <InputGroup
                @name={{t "storefront.common.twitter"}}
                @value={{@model.twitter}}
                @placeholder={{t "storefront.settings.index.twitter-placeholder"}}
                @helpText={{t "storefront.settings.index.twitter-help-text"}}
            />
            </ContentPanel>
        </ContentPanel>
    </section>

    <section id="settings-branding" class="storefront-settings-section" data-test-settings-section="branding">
        <ContentPanel @title={{t "storefront.settings.sections.branding"}} @open={{true}} @pad={{false}} @wrapperClass="bordered-classic">
            <InputGroup @name={{t "storefront.common.logo"}} @helpText={{t "storefront.settings.index.logo-help-text"}}>
                <div class="flex flex-row items-center">
                    <img src={{@model.logo_url}} alt={{concat @model.name " logo"}} class="h-20 w-64 border dark:border-gray-900 rounded-md mr-4" />
                    <FileUpload @name={{t "storefront.common.logo"}} @accept="image/*" @onFileAdded={{fn this.uploadFile "storefront_logo"}} as |queue|>
                        <a tabindex={{0}} class="flex items-center px-0 mt-2 text-xs no-underline truncate btn btn-sm btn-default">
                            {{#if queue.files.length}}
                                <Spinner class="mr-1" />
                                <span>
                                    {{t "storefront.common.uploading"}}
                                </span>
                            {{else}}
                                <FaIcon @icon="image" class="mr-1" />
                                <span>
                                    {{t "storefront.settings.index.upload-new-logo"}}
                                </span>
                            {{/if}}
                        </a>
                    </FileUpload>
                </div>
            </InputGroup>

            <InputGroup @name={{t "storefront.common.backdrop"}} @helpText={{t "storefront.settings.index.backdrop-help-text"}}>
                <div class="flex flex-row items-center">
                    <img src={{@model.backdrop_url}} alt={{concat @model.name " backdrop"}} class="h-20 w-64 border dark:border-gray-900 rounded-md mr-4" />
                    <FileUpload @name={{t "storefront.common.backdrop"}} @accept="image/*" @onFileAdded={{fn this.uploadFile "storefront_backdrop"}} as |queue|>
                        <a tabindex={{0}} class="flex items-center px-0 mt-2 text-xs no-underline truncate btn btn-sm btn-default">
                            {{#if queue.files.length}}
                                <Spinner class="mr-1" />
                                <span>
                                    {{t "storefront.common.uploading"}}
                                </span>
                            {{else}}
                                <FaIcon @icon="image" class="mr-1" />
                                <span>
                                    {{t "storefront.settings.index.upload-new-backdrop"}}
                                </span>
                            {{/if}}
                        </a>
                    </FileUpload>
                </div>
            </InputGroup>
            <ContentPanel @title={{t "storefront.settings.index.images-videos"}} @open={{false}} @pad={{false}} @wrapperClass="bordered-top">
            <div class="p-6">
                {{#if this.isUploading}}
                    <div
                        class="min-h-56 dropzone w-full rounded px-4 py-8 min-h bg-black bg-opacity-25 text-gray-900 dark:text-white text-center flex flex-col items-center justify-center border-2 border-dashed border-gray-200 dark:border-indigo-500"
                    >
                        <div class="flex items-center justify-center py-5">
                            <PageLoader class="text-sm dar:text-gray-100" @loadingMessage="Uploading..." />
                        </div>
                    </div>
                {{else}}
                    <FileDropzone
                        @name={{t "storefront.common.file"}}
                        @multiple={{true}}
                        @onFileAdded={{this.queueFile}}
                        @accept={{join "," this.acceptedFileTypes}}
                        class="dropzone file-dropzone"
                        as |dropzone queue|
                    >
                        {{#if dropzone.active}}
                            {{#if dropzone.valid}}
                                {{t "storefront.settings.index.drop-to-upload"}}
                            {{else}}
                                {{t "storefront.common.invalid"}}
                            {{/if}}
                        {{else if queue.files.length}}
                            <div class="my-2">
                                <FaIcon @icon="photo-video" class="text-indigo-500 mr-2" />
                                {{pluralize queue.files.length "file"}}
                                {{t "storefront.settings.index.ready-to-upload"}}
                            </div>
                            <div class="my-2">({{queue.progress}}%)</div>
                        {{else}}
                            <h4 class="font-semibold mb-8">
                                <FaIcon @icon="photo-video" @size="2x" class="text-indigo-500 mr-2" />
                                {{t "storefront.settings.index.upload-image-video"}}
                            </h4>
                            <div>
                                {{#if dropzone.supported}}
                                    <p class="text-base font-semibold my-5">{{t "storefront.settings.index.drag-and-drop-image"}}</p>
                                {{/if}}
                                <FileUpload
                                    @name={{t "storefront.common.file"}}
                                    @for="files"
                                    @accept={{join "," this.acceptedFileTypes}}
                                    @multiple={{true}}
                                    @onFileAdded={{this.queueFile}}
                                >
                                    <a tabindex={{0}} class="btn btn-magic cursor-pointer ml-1">or select files to upload.</a>
                                </FileUpload>
                            </div>
                        {{/if}}
                    </FileDropzone>
                    {{#if this.uploadQueue}}
                        <div class="mx-4 my-6">
                            <div class="flex items-center justify-between mb-4">
                                <span class="leading-6 dark:text-gray-100">{{t "storefront.settings.index.upload-queue"}}</span>
                            </div>
                            <div class="space-y-2 mb-5">
                                {{#each this.uploadQueue as |file|}}
                                    <div class="flex items-center justify-between bg-green-100 border border-gray-300 dark:border-gray-900 py-2 shadow-sm rounded-lg px-4">
                                        <div class="text-sm text-green-900">{{file.name}}</div>
                                        <div class="flex items-center text-sm">
                                            <Spinner class="text-green-400 mr-2" />
                                            <span class="font-bold text-green-400">{{round file.progress}}%</span>
                                        </div>
                                    </div>
                                {{/each}}
                            </div>
                        </div>
                    {{/if}}
                    <div>
                        <div class="grid grid-cols-2 md:grid-cols-3 gap-3 mt-6">
                            {{#each @model.files as |file|}}
                                <FileRecord @file={{file}} @onDelete={{this.removeFile}} />
                            {{/each}}
                        </div>
                    </div>
                {{/if}}
            </div>
            </ContentPanel>
        </ContentPanel>
    </section>

    <section id="settings-hours" class="storefront-settings-section" data-test-settings-section="hours">
        <ContentPanel @title={{t "storefront.settings.sections.hours"}} @open={{true}} @pad={{false}} @wrapperClass="bordered-classic">
            <div class="storefront-settings-section__toolbar">
                <p class="storefront-settings-section__lede">{{t "storefront.settings.hours.lede"}}</p>
                <Button @size="sm" @icon="pencil" @text={{t "storefront.settings.hours.edit"}} @onClick={{this.editHours}} @permission="storefront update store-location" data-test-edit-hours />
            </div>
            {{#if this.locations.length}}
                <div class="storefront-member-list" data-test-hours-locations>
                    {{#each this.locations as |location|}}
                        <div class="storefront-member-row storefront-hours-row" data-test-hours-location={{location.id}}>
                            <div class="storefront-member-row__identity">
                                <div class="storefront-member-row__name">{{location.name}}</div>
                                <div class="storefront-member-row__meta">{{n-a (or location.address location.place.address)}}</div>
                            </div>
                            <div class="storefront-hours-row__strip">
                                <Storefront::HoursStrip @hours={{location.hours}} @showCount={{true}} />
                            </div>
                        </div>
                    {{/each}}
                </div>
            {{else}}
                <p class="storefront-settings-section__note mt-0">{{t "storefront.settings.hours.empty"}}</p>
            {{/if}}
        </ContentPanel>
    </section>

    <section id="settings-checkout" class="storefront-settings-section" data-test-settings-section="checkout">
        <ContentPanel @title={{t "storefront.settings.sections.checkout-rules"}} @open={{true}} @pad={{false}} @wrapperClass="bordered-classic">
            <p class="storefront-settings-section__lede">{{t "storefront.settings.sections.checkout-rules-lede"}}</p>
            <div class="storefront-rules">
                <Storefront::SettingRule @icon="plug" @label={{t "storefront.common.online"}} @description={{t "storefront.settings.rules.online"}} @value={{@model.online}} @onToggle={{fn (mut @model.online)}} data-test-rule="online" />
                <Storefront::SettingRule @icon="person-booth" @label={{t "storefront.settings.rules.pickup-label"}} @description={{t "storefront.settings.rules.pickup"}} @value={{@model.options.pickup_enabled}} @onToggle={{fn this.setOption "pickup_enabled"}} data-test-rule="pickup" />
                <Storefront::SettingRule @icon="cash-register" @label={{t "storefront.settings.rules.tips-label"}} @description={{t "storefront.settings.rules.tips"}} @value={{@model.options.tips_enabled}} @onToggle={{fn this.setOption "tips_enabled"}} data-test-rule="tips" />
                <Storefront::SettingRule @icon="face-smile" @label={{t "storefront.settings.rules.delivery-tips-label"}} @description={{t "storefront.settings.rules.delivery-tips"}} @value={{@model.options.delivery_tips_enabled}} @onToggle={{fn this.setOption "delivery_tips_enabled"}} data-test-rule="delivery-tips" />
                <Storefront::SettingRule @icon="dollar-sign" @label={{t "storefront.settings.rules.minimum-label"}} @description={{t "storefront.settings.rules.minimum"}} @value={{@model.options.required_checkout_min}} @onToggle={{fn this.setOption "required_checkout_min"}} data-test-rule="minimum">
                    <MoneyInput @wrapperClass="mb-0" @name={{t "storefront.settings.index.minimum-order-amount"}} @value={{@model.options.required_checkout_min_amount}} @currency={{@model.currency}} />
                </Storefront::SettingRule>
                <Storefront::SettingRule @icon="money-bill-wave" @label={{t "storefront.settings.rules.cod-label"}} @description={{t "storefront.settings.rules.cod"}} @value={{@model.options.cod_enabled}} @onToggle={{fn this.setOption "cod_enabled"}} data-test-rule="cod" />
                <Storefront::SettingRule @icon="percent" @label={{t "storefront.settings.rules.tax-label"}} @description={{t "storefront.settings.rules.tax"}} @value={{@model.options.tax_enabled}} @onToggle={{fn this.setOption "tax_enabled"}} data-test-rule="tax">
                    <InputGroup @wrapperClass="mb-0" @type="number" @name={{t "storefront.settings.index.tax-percentage"}} @value={{@model.options.tax_percentage}} @placeholder={{t "storefront.settings.index.tax-percentage"}} @helpText={{t "storefront.settings.index.tax-percentage-help-text"}} />
                </Storefront::SettingRule>
                <Storefront::SettingRule @icon="robot" @label={{t "storefront.settings.rules.auto-accept-label"}} @description={{t "storefront.settings.rules.auto-accept"}} @value={{@model.options.auto_accept_orders}} @onToggle={{fn this.setOption "auto_accept_orders"}} data-test-rule="auto-accept" />
                <Storefront::SettingRule @icon="paper-plane" @label={{t "storefront.settings.rules.auto-dispatch-label"}} @description={{t "storefront.settings.rules.auto-dispatch"}} @value={{@model.options.auto_dispatch}} @onToggle={{fn this.setOption "auto_dispatch"}} data-test-rule="auto-dispatch" />
                <Storefront::SettingRule @icon="signature" @label={{t "storefront.settings.rules.pod-label"}} @description={{t "storefront.settings.rules.pod"}} @value={{@model.options.require_pod}} @onToggle={{fn this.setOption "require_pod"}} data-test-rule="pod">
                    <InputGroup @wrapperClass="mb-0" @name={{t "storefront.settings.index.proof-of-delivery-method"}}>
                        <Select @options={{this.podMethods}} @optionValue="value" @optionLabel="name" @value={{@model.pod_method}} @onSelect={{fn (mut @model.pod_method)}} class="w-full" />
                    </InputGroup>
                </Storefront::SettingRule>
            </div>
            {{#if this.memberNetworks.length}}
                <p class="storefront-settings-section__note">{{t "storefront.settings.rules.network-note"}}</p>
            {{/if}}
        </ContentPanel>
    </section>

    <section id="settings-alerts" class="storefront-settings-section" data-test-settings-section="alerts">
        <ContentPanel @title={{t "storefront.common.alerts"}} @open={{true}} @pad={{false}} @wrapperClass="bordered-classic">
            <div>
                <p class="dark:text-gray-100 mb-4">{{t "storefront.settings.index.alerted-for-certain-event"}}</p>
                <InputGroup @name={{t "storefront.settings.index.new-order-alert"}} @wrapperClass="mb-0">
                    <ModelSelectMultiple
                        @modelName="user"
                        @selectedItemComponent={{component "select-option/user" compact=true}}
                        @selectedModel={{@model.alertable.for_new_order}}
                        @placeholder={{t "storefront.settings.index.alert-placeholder"}}
                        @triggerClass="form-select form-input multiple"
                        @infiniteScroll={{false}}
                        @renderInPlace={{true}}
                        @onChange={{fn this.makeAlertable "for_new_order"}}
                        as |model|
                    >
                        <SelectOption::User @option={{model}} />
                    </ModelSelectMultiple>
                </InputGroup>
            </div>
        </ContentPanel>
    </section>

    <section id="settings-danger" class="storefront-settings-section" data-test-settings-section="danger">
        <ContentPanel @title={{t "storefront.settings.sections.danger"}} @open={{true}} @pad={{false}} @wrapperClass="bordered-classic storefront-settings-danger">
            <p class="storefront-settings-section__lede">{{t "storefront.settings.danger.lede"}}</p>
            <div class="storefront-settings-danger__row">
                <div>
                    <div class="storefront-settings-danger__title">{{t "storefront.settings.danger.delete-title" name=@model.name}}</div>
                    <div class="storefront-settings-danger__description">{{t "storefront.settings.danger.delete-description"}}</div>
                </div>
                <Button @type="danger" @size="sm" @icon="trash" @text={{t "storefront.settings.danger.delete-button"}} @onClick={{this.deleteStore}} @permission="storefront delete store" data-test-delete-store />
            </div>
        </ContentPanel>
    </section>

    <Spacer @height="120px" />

    <div class="storefront-save-bar {{if this.isDirty 'is-dirty'}}" data-test-save-bar>
        <div class="storefront-save-bar__status">
            {{#if this.isDirty}}
                <FaIcon @icon="circle" @size="xs" class="text-amber-500 mr-2" />
                {{t "storefront.settings.save-bar.unsaved" count=this.dirtyCount}}
                {{#if this.dirtySections.length}}
                    <span class="storefront-save-bar__sections">{{join " · " this.dirtySections}}</span>
                {{/if}}
            {{else}}
                <FaIcon @icon="check" @size="xs" class="text-green-500 mr-2" />
                {{t "storefront.settings.save-bar.saved"}}
            {{/if}}
        </div>
        <div class="storefront-save-bar__actions">
            <Button @text={{t "storefront.settings.save-bar.discard"}} @disabled={{not this.isDirty}} @onClick={{this.discardChanges}} />
            <Button @buttonType="submit" @type="primary" @icon="save" @text={{t "storefront.settings.save-bar.save"}} @isLoading={{this.isLoading}} @disabled={{not this.isDirty}} @onClick={{this.saveSettings}} @permission="storefront update settings" />
        </div>
    </div>
</form>
