{{! Customers in the view the page is in: cards, or a table that is not selectable. }}
<Storefront::ViewLoading @controller="customers/index" @property="viewMode" @value="cards" as |isCards|>
    {{#if isCards}}
        <Skeleton::Page @hideAvatar={{true}} @actions={{1}} @label={{t "storefront.common.loading"}} class="storefront-loading" data-test-storefront-loading="customers" data-test-loading-view="cards">
            <Skeleton::CardsGrid @count={{8}} @columns={{4}} @hideMedia={{true}} @avatar={{true}} @status={{false}} @lines={{2}} @footerActions={{2}} @footerBadge={{true}} @footerLines={{1}} />
        </Skeleton::Page>
    {{else}}
        <Skeleton::Page
            @hideAvatar={{true}}
            @actions={{3}}
            @toolbar={{false}}
            @checkbox={{false}}
            @columns={{8}}
            @rows={{10}}
            @label={{t "storefront.common.loading"}}
            class="storefront-loading"
            data-test-storefront-loading="customers"
            data-test-loading-view="table"
        />
    {{/if}}
</Storefront::ViewLoading>
