<Overlay @position="right" @isResizable={{true}} @noBackdrop={{true}} @width="min(1040px, calc(100vw - 15rem))" @minResizeWidth={{760}} @fullHeight={{true}} @containerClass="border-l border-transparent dark:border-gray-700">
    <Overlay::Header @onPressCancel={{this.cancel}} class="storefront-create-order__header">
        <:default>
            <div class="min-w-0">
                <div class="storefront-create-order__title">{{if this.isBooking (t "storefront.orders.booking.title") (t "storefront.orders.create.title")}}</div>
                <div class="storefront-create-order__store">{{if this.activeStore this.activeStore.name this.network.name}} · {{if this.isBooking (t "storefront.orders.booking.subtitle") (t "storefront.orders.create.subtitle")}}</div>
            </div>
        </:default>
    </Overlay::Header>
    <Overlay::Body class="p-0i storefront-overlay-body" @wrapperClass="storefront-create-order" data-test-create-order>
        <div class="storefront-create-order__steps {{if this.isBooking 'is-booking'}}">
            {{#if this.isNetworkContext}}
                {{! Network context: which member store the order is placed with }}
                <section class="storefront-create-order__sec" data-test-create-order-step="store">
                    <h3 class="storefront-create-order__sec-title">{{this.stepNumbers.store}} · {{t "storefront.common.store"}}<span class="storefront-create-order__sec-hint">{{t "storefront.orders.create.store-hint"}}</span></h3>
                    <div class="storefront-create-order__places storefront-create-order__places--grid" data-test-create-order-stores>
                        {{#each this.storeOptionRows as |row|}}
                            <button type="button" class="storefront-create-order__place {{if row.isSelected 'is-selected'}}" {{on "click" (perform this.selectStore row.store)}} data-test-create-order-store={{row.store.id}}>
                                <Resource::Pill @resource={{row.store}} @resourceType="store" @static={{true}} @noPopover={{true}} @showOnlineIndicator={{true}} @subtitle="{{row.store.currency}}{{if row.store.category.name (concat ' · ' row.store.category.name)}}" />
                            </button>
                        {{/each}}
                    </div>
                    {{#if this.selectStore.isRunning}}<Spinner @size="sm" class="mt-2" />{{/if}}
                </section>
            {{/if}}

            {{! 1 · Customer }}
            <section class="storefront-create-order__sec" data-test-create-order-step="customer">
                <h3 class="storefront-create-order__sec-title">{{this.stepNumbers.customer}} · {{t "storefront.common.customer"}}</h3>
                {{#if this.selectedCustomer}}
                    <div class="storefront-create-order__picked">
                        <Customer::Pill @customer={{this.selectedCustomer}} @subtitle="{{n-a this.selectedCustomer.phone}}{{if this.selectedCustomer.email (concat ' · ' this.selectedCustomer.email)}}" />
                        <Button @size="xs" @icon="times" @helpText={{t "storefront.orders.create.change-customer"}} @onClick={{fn this.selectCustomer null}} class="ml-1" data-test-change-customer />
                    </div>
                {{else}}
                    <div class="storefront-create-order__field">
                        <div class="storefront-create-order__dropoff-row">
                            <ModelSelect @modelName="customer" @selectedModel={{this.selectedCustomer}} @placeholder={{t "storefront.orders.create.customer-placeholder"}} @triggerClass="form-select form-input" @infiniteScroll={{false}} @renderInPlace={{true}} @onChange={{this.selectCustomer}} as |model|>
                                <SelectOption::Customer @option={{model}} />
                            </ModelSelect>
                            <Button @size="sm" @icon="user-plus" @text={{t "storefront.customers.create.button"}} @onClick={{this.newCustomer}} @permission="storefront create customer" data-test-new-customer-button />
                        </div>
                        <p class="storefront-create-order__help">{{t "storefront.orders.create.customer-help"}}</p>
                    </div>
                {{/if}}
            </section>

            {{! 2 · Fulfillment }}
            <section class="storefront-create-order__sec storefront-create-order__sec--when" data-test-create-order-step="fulfillment">
                <h3 class="storefront-create-order__sec-title">{{this.stepNumbers.fulfillment}} · {{if this.isBooking (t "storefront.orders.booking.when-where") (t "storefront.networks.orders.columns.fulfillment")}}</h3>
                {{#if this.isBooking}}
                    {{#if this.bookableLine}}
                        <div class="storefront-create-order__field" data-test-create-order-booking>
                            <Storefront::Order::BookingSlots @product={{this.bookableLine.product}} @value={{this.scheduledAt}} @onSelect={{this.selectSlot}} />
                        </div>
                    {{else}}
                        <p class="storefront-create-order__help mt-0">{{t "storefront.orders.booking.add-service-first"}}</p>
                    {{/if}}
                {{/if}}
                <div class="storefront-create-order__row">
                    <Storefront::ViewToggle
                        @options={{if
                            this.isBooking
                            (array (hash id="delivery" label=(t "storefront.orders.booking.at-customer")) (hash id="pickup" label=(t "storefront.orders.booking.at-store")))
                            (array (hash id="delivery" label=(t "storefront.networks.orders.delivery")) (hash id="pickup" label=(t "storefront.common.pickup")))
                        }}
                        @value={{if this.isPickup "pickup" "delivery"}}
                        @onChange={{this.setFulfillment}}
                        @label={{t "storefront.orders.create.fulfillment"}}
                        data-test-fulfillment-toggle
                    />
                    {{#unless this.isBooking}}
                        <Storefront::ViewToggle @options={{array (hash id="asap" label=(t "storefront.order.asap")) (hash id="schedule" label=(t "storefront.orders.create.schedule"))}} @value={{if this.isScheduled "schedule" "asap"}} @onChange={{this.setTiming}} @label={{t "storefront.orders.create.schedule"}} data-test-timing-toggle />
                        {{#if this.isScheduled}}
                            <DateTimeInput role="group" aria-label={{t "storefront.orders.create.schedule"}} class="form-input" @value={{this.scheduledAt}} @onUpdate={{this.setScheduledAt}} />
                        {{/if}}
                    {{/unless}}
                    <span class="storefront-create-order__help mt-0">{{if this.isBooking (t "storefront.orders.booking.where-help") (t "storefront.orders.create.fulfillment-help")}}</span>
                </div>
                <div class="storefront-create-order__grid">
                    <div class="storefront-create-order__field">
                        <div class="storefront-create-order__label">{{if this.isBooking (if this.isPickup (t "storefront.orders.booking.at-location") (t "storefront.orders.booking.provider-from")) (if this.isPickup (t "storefront.orders.create.pickup-from") (t "storefront.orders.create.leaves-from"))}}</div>
                        {{#if this.locationRows.length}}
                            <div class="storefront-create-order__places" data-test-create-order-locations>
                                {{#each this.locationRows as |row|}}
                                    <button type="button" class="storefront-create-order__place {{if row.isSelected 'is-selected'}}" {{on "click" (fn this.selectLocation row.location)}} data-test-create-order-location={{row.location.id}}>
                                        <span class="storefront-create-order__tile"><FaIcon @icon="store" @size="xs" /></span>
                                        <span class="storefront-create-order__place-text">
                                            <span class="storefront-create-order__place-name">{{row.location.name}}</span>
                                            <span class="storefront-create-order__place-address">{{n-a row.location.place.address row.location.address}}</span>
                                        </span>
                                        <Badge @status="default" @size="xs" @hideStatusDot={{true}} @text={{t "storefront.orders.create.store-location"}} />
                                    </button>
                                {{/each}}
                            </div>
                        {{else}}
                            <p class="storefront-create-order__help">{{t "storefront.orders.create.no-locations"}}</p>
                        {{/if}}
                        <p class="storefront-create-order__help">{{t "storefront.orders.create.location-help"}}</p>
                    </div>
                    {{#unless this.isPickup}}
                        <div class="storefront-create-order__field" data-test-create-order-dropoff>
                            <div class="storefront-create-order__label">{{if this.isBooking (t "storefront.orders.booking.service-address") (t "storefront.orders.create.deliver-to")}}</div>
                            {{#if this.selectedCustomer}}
                                {{#if this.placeRows.length}}
                                    <div class="storefront-create-order__places">
                                        {{#each this.placeRows as |row|}}
                                            <button type="button" class="storefront-create-order__place {{if row.isSelected 'is-selected'}}" {{on "click" (fn this.selectDropoff row.place)}} data-test-dropoff={{row.place.id}}>
                                                <span class="storefront-create-order__tile"><FaIcon @icon="house" @size="xs" /></span>
                                                <span class="storefront-create-order__place-text">
                                                    <span class="storefront-create-order__place-name">{{n-a row.place.name (t "storefront.common.address")}}</span>
                                                    <span class="storefront-create-order__place-address">{{n-a row.place.address}}</span>
                                                </span>
                                                {{#if row.distance}}<span class="storefront-create-order__distance">{{row.distance}}</span>{{/if}}
                                                {{#if row.isDefault}}<Badge @status="default" @size="xs" @hideStatusDot={{true}} @text={{t "storefront.customers.panel.default"}} />{{/if}}
                                            </button>
                                        {{/each}}
                                    </div>
                                {{/if}}
                                {{#if (and this.otherDropoff (not this.changingDropoff))}}
                                    <div class="storefront-create-order__places">
                                        <div class="storefront-create-order__place is-selected is-static" data-test-other-dropoff>
                                            <span class="storefront-create-order__tile"><FaIcon @icon="map-marker-alt" @size="xs" /></span>
                                            <span class="storefront-create-order__place-text">
                                                <span class="storefront-create-order__place-name">{{n-a this.otherDropoff.name (t "storefront.common.address")}}</span>
                                                <span class="storefront-create-order__place-address">{{n-a this.otherDropoff.address}}</span>
                                            </span>
                                        </div>
                                    </div>
                                    <button type="button" class="storefront-create-order__text-action" {{on "click" this.changeDropoff}} data-test-change-dropoff>
                                        <FaIcon @icon="pen" @size="xs" />
                                        {{t "storefront.orders.create.change-address"}}
                                    </button>
                                {{else}}
                                    <div class="storefront-create-order__dropoff-row">
                                        <ModelSelect @modelName="place" @selectedModel={{this.otherDropoff}} @placeholder={{t "storefront.orders.create.other-address"}} @triggerClass="form-select form-input" @infiniteScroll={{false}} @renderInPlace={{true}} @onChange={{this.selectDropoff}} as |model|>
                                            <SelectOption::Place @option={{model}} />
                                        </ModelSelect>
                                        <Button
                                            @size="sm"
                                            @icon="plus"
                                            @helpText={{t "storefront.orders.create.new-address"}}
                                            @onClick={{this.openNewAddress}}
                                            @permission="fleet-ops create place"
                                            aria-label={{t "storefront.orders.create.new-address"}}
                                            data-test-new-address
                                        />
                                    </div>
                                {{/if}}
                                <p class="storefront-create-order__help">{{if this.placeRows.length (t "storefront.orders.create.dropoff-help") (t "storefront.orders.create.no-places")}}</p>
                            {{else}}
                                <input type="text" class="form-input w-full" disabled placeholder={{t "storefront.orders.create.other-address"}} aria-label={{t "storefront.orders.create.deliver-to"}} />
                                <p class="storefront-create-order__help">{{t "storefront.orders.create.pick-customer-first"}}</p>
                            {{/if}}
                        </div>
                    {{/unless}}
                </div>
                {{#if this.isBooking}}
                    <div class="storefront-create-order__field storefront-create-order__notes">
                        <label class="storefront-create-order__label" for="create-booking-notes">{{t "storefront.orders.booking.job-notes"}}</label>
                        <Textarea id="create-booking-notes" class="form-input w-full" rows="2" @value={{this.notes}} placeholder={{t "storefront.orders.booking.job-notes-placeholder"}} {{on "input" this.setNotes}} />
                    </div>
                {{/if}}
            </section>

            {{#if this.isBooking}}
                {{! 4 · Provider: a booking's provider is one of the company's drivers }}
                <section class="storefront-create-order__sec storefront-create-order__sec--provider" data-test-create-order-step="provider">
                    <h3 class="storefront-create-order__sec-title">{{this.stepNumbers.provider}} · {{t "storefront.orders.booking.provider"}}</h3>
                    <div class="storefront-create-order__places">
                        <button type="button" class="storefront-create-order__place {{unless this.provider 'is-selected'}}" {{on "click" (fn this.setProvider null)}} data-test-provider-any>
                            <span class="storefront-create-order__tile"><FaIcon @icon="users" @size="xs" /></span>
                            <span class="storefront-create-order__place-text">
                                <span class="storefront-create-order__place-name">{{t "storefront.orders.booking.any-provider"}}</span>
                                <span class="storefront-create-order__place-address">{{t "storefront.orders.booking.assign-at-confirmation"}}</span>
                            </span>
                        </button>
                        {{#if this.provider}}
                            <div class="storefront-create-order__place is-selected is-static" data-test-provider-picked>
                                <Driver::Pill @driver={{this.provider}} @static={{true}} @noPopover={{true}} />
                            </div>
                        {{/if}}
                    </div>
                    <div class="storefront-create-order__dropoff-row">
                        <ModelSelect @modelName="driver" @selectedModel={{this.provider}} @placeholder={{t "storefront.orders.booking.choose-provider"}} @triggerClass="form-select form-input" @infiniteScroll={{false}} @renderInPlace={{true}} @onChange={{this.setProvider}} as |model|>
                            <span class="storefront-create-order__place-text">
                                <span class="storefront-create-order__place-name">{{model.name}}</span>
                                <span class="storefront-create-order__place-address">{{n-a model.phone (t "storefront.orders.booking.driver")}}</span>
                            </span>
                        </ModelSelect>
                    </div>
                    <p class="storefront-create-order__help">{{t "storefront.orders.booking.provider-help"}}</p>
                </section>
            {{/if}}

            {{! 3 · Items }}
            <section class="storefront-create-order__sec storefront-create-order__sec--last" data-test-create-order-step="items">
                <h3 class="storefront-create-order__sec-title">
                    {{this.stepNumbers.items}} · {{if this.isBooking (t "storefront.orders.booking.services-products") (t "storefront.order.tabs.items")}}<span class="storefront-create-order__sec-hint">{{if this.isBooking (t "storefront.orders.booking.services-hint") (t "storefront.orders.create.items-hint")}}</span>
                    {{#unless this.pickerVisible}}
                        <Button @type="primary" @size="xs" @icon="plus" @text={{t "storefront.orders.create.add-products"}} @onClick={{this.openPicker}} class="ml-auto" data-test-add-products />
                    {{/unless}}
                </h3>
                {{#if this.lineRows.length}}
                    <div class="storefront-create-order__table-wrap">
                    <table class="storefront-create-order__table" data-test-order-lines>
                        <thead>
                            <tr>
                                <th>{{t "storefront.orders.create.product"}}</th>
                                {{#if this.isBooking}}<th>{{t "storefront.orders.booking.type"}}</th>{{/if}}
                                <th>{{t "storefront.orders.create.options"}}</th>
                                <th class="storefront-create-order__th-qty">{{t "storefront.orders.create.qty"}}</th>
                                <th class="is-right">{{t "storefront.orders.create.price"}}</th>
                                <th class="is-right">{{t "storefront.networks.orders.columns.total"}}</th>
                                <th></th>
                            </tr>
                        </thead>
                        <tbody>
                            {{#each this.lineRows as |line|}}
                                <tr class="{{if line.unavailable 'is-unavailable'}}" data-test-order-line={{line.key}}>
                                    <td>
                                        <span class="storefront-create-order__product">
                                            <Image src={{line.product.primary_image_url}} @fallbackSrc={{config "defaultValues.placeholderImage"}} alt={{line.product.name}} class="storefront-create-order__thumb" />
                                            <span class="storefront-create-order__place-text">
                                                <span class="storefront-create-order__place-name">{{line.product.name}}</span>
                                                <span class="storefront-create-order__place-address">
                                                    {{#if (and this.isBooking line.isService)}}
                                                        {{n-a line.length line.product.category.name}}
                                                    {{else if (and this.isBooking (not this.isPickup))}}
                                                        {{t "storefront.orders.booking.brought-along"}}
                                                    {{else}}
                                                        {{n-a line.product.category.name}}
                                                    {{/if}}
                                                    {{#if line.unavailable}} · <span class="text-red-500">{{t "storefront.catalogs.editor.out-of-stock"}}</span>{{/if}}
                                                </span>
                                            </span>
                                        </span>
                                    </td>
                                    {{#if this.isBooking}}
                                        <td><Badge @status={{if line.isService "info" "default"}} @size="xs" @hideStatusDot={{true}} @text={{if line.isService (t "storefront.orders.booking.service") (t "storefront.orders.booking.product")}} /></td>
                                    {{/if}}
                                    <td class="storefront-create-order__options-cell">{{#if line.optionsLabel}}{{line.optionsLabel}}{{else}}—{{/if}}</td>
                                    <td>
                                        <span class="storefront-create-order__qty">
                                            <button type="button" aria-label={{t "storefront.orders.create.decrease"}} disabled={{eq line.quantity 1}} {{on "click" (fn this.changeQuantity line -1)}}>−</button>
                                            <span>{{line.quantity}}</span>
                                            <button type="button" aria-label={{t "storefront.orders.create.increase"}} {{on "click" (fn this.changeQuantity line 1)}}>+</button>
                                        </span>
                                    </td>
                                    <td class="is-right">{{format-currency line.unitPrice this.currency}}</td>
                                    <td class="is-right font-semibold">{{format-currency line.total this.currency}}</td>
                                    <td class="is-right"><Button @size="xs" @icon="times" @helpText={{t "common.remove"}} @onClick={{fn this.removeLine line}} /></td>
                                </tr>
                            {{/each}}
                        </tbody>
                    </table>
                    </div>
                    {{#if (and this.isBooking (not this.isPickup) this.bookingSplit.productsCount)}}
                        <p class="storefront-create-order__help">{{t "storefront.orders.booking.products-ride"}}</p>
                    {{/if}}
                {{/if}}

                {{#if this.pickerVisible}}
                    <Storefront::Order::ProductPicker @products={{this.pickerProducts}} @currency={{this.currency}} @onAdd={{this.addLine}} @onDone={{if this.lineRows.length this.closePicker}} />
                {{/if}}

                {{#unless this.isBooking}}
                    <div class="storefront-create-order__field storefront-create-order__notes">
                        <label class="storefront-create-order__label" for="create-order-notes">{{t "storefront.orders.create.notes"}}</label>
                        <Textarea id="create-order-notes" class="form-input w-full" rows="3" @value={{this.notes}} placeholder={{t "storefront.orders.create.notes-placeholder"}} {{on "input" this.setNotes}} />
                    </div>
                {{/unless}}
                <Spacer @height="60px" />
            </section>
        </div>

        <aside class="storefront-create-order__summary" data-test-create-order-summary>
            {{#if this.isBooking}}
                <section class="storefront-create-order__sec" data-test-booking-card>
                    <h3 class="storefront-create-order__sec-title">{{t "storefront.orders.booking.booking"}}</h3>
                    {{#if this.bookingWhen}}
                        <div class="storefront-create-order__booking">
                            <FaIcon @icon="calendar-check" class="storefront-create-order__booking-icon" />
                            <span class="storefront-create-order__place-text">
                                <span class="storefront-create-order__place-name">{{this.bookingWhen}}</span>
                                <span class="storefront-create-order__place-address">{{n-a this.bookingWhere}}</span>
                            </span>
                        </div>
                    {{else}}
                        <p class="storefront-create-order__help mt-0">{{t "storefront.orders.booking.pick-slot"}}</p>
                    {{/if}}
                </section>
            {{/if}}
            <section class="storefront-create-order__sec">
                <h3 class="storefront-create-order__sec-title">{{t "storefront.orders.create.promotion"}}</h3>
                <form class="storefront-create-order__promo" {{on "submit" this.applyPromoCode}}>
                    <Input class="form-input form-input-sm w-full uppercase" @value={{this.promoCode}} placeholder={{t "storefront.orders.create.promo-placeholder"}} aria-label={{t "storefront.orders.create.promo-placeholder"}} {{on "input" this.setPromoCode}} />
                    {{#if this.appliedPromoCode}}
                        <Button @size="sm" @icon="times" @onClick={{this.clearPromoCode}} />
                    {{else}}
                        <Button @size="sm" @buttonType="submit" @text={{t "storefront.orders.create.apply"}} @onClick={{this.applyPromoCode}} />
                    {{/if}}
                </form>
                {{#each this.quote.promotions.applied as |promotion|}}
                    <div class="storefront-create-order__promo-applied"><Badge @status="success" @size="xs" @hideStatusDot={{true}} @text={{t "storefront.orders.create.promo-applied" name=(or promotion.code promotion.name)}} />{{#if promotion.name}}<span class="storefront-create-order__help mt-0">{{promotion.name}}</span>{{/if}}</div>
                {{/each}}
            </section>

            <section class="storefront-create-order__sec">
                <h3 class="storefront-create-order__sec-title">{{t "storefront.order.tabs.payment"}}</h3>
                <div class="storefront-create-order__field">
                    <label class="storefront-create-order__label" for="create-order-payment">{{t "storefront.orders.create.method"}}</label>
                    <Select id="create-order-payment" class="w-full" @value={{this.payment}} @options={{this.paymentOptions}} @optionLabel="label" @optionValue="value" @onSelect={{this.setPayment}} data-test-payment />
                    <p class="storefront-create-order__help">{{if this.isBooking (t "storefront.orders.booking.payment-help") (t "storefront.orders.create.payment-help")}}</p>
                </div>
                {{#unless this.isBooking}}
                <div class="storefront-create-order__field">
                    <div class="storefront-create-order__label">{{t "storefront.orders.create.tip"}}</div>
                    <Storefront::ViewToggle @options={{array (hash id="none" label=(t "storefront.orders.create.tip-none")) (hash id="fixed" label=(format-currency 350 this.currency)) (hash id="percent-10" label="10%") (hash id="percent-20" label="20%") (hash id="percent-30" label="30%") (hash id="custom" label=(t "storefront.orders.create.tip-custom"))}} @value={{this.tipMode}} @onChange={{this.setTipMode}} @label={{t "storefront.orders.create.tip"}} data-test-tip-toggle />
                    {{#if (eq this.tipMode "custom")}}
                        <MoneyInput class="w-full mt-2" @currency={{this.currency}} @value={{this.tipCustom}} @canSelectCurrency={{false}} @onChange={{this.setTipCustom}} />
                    {{/if}}
                </div>
                {{/unless}}
            </section>

            <section class="storefront-create-order__sec storefront-create-order__sec--grow">
                <h3 class="storefront-create-order__sec-title">{{t "storefront.orders.create.summary"}}</h3>
                <dl class="storefront-create-order__totals">
                    {{#if this.isBooking}}
                        {{#each this.bookingSplit.services as |service|}}
                            <div><dt>{{service.label}}</dt><dd>{{format-currency service.total this.currency}}</dd></div>
                        {{/each}}
                        {{#if this.bookingSplit.productsCount}}
                            <div><dt>{{if this.isPickup (t "storefront.orders.booking.products" count=this.bookingSplit.productsCount) (t "storefront.orders.booking.products-brought" count=this.bookingSplit.productsCount)}}</dt><dd>{{format-currency this.bookingSplit.productsTotal this.currency}}</dd></div>
                        {{/if}}
                    {{else}}
                        <div><dt>{{t "storefront.orders.create.subtotal" count=this.totals.items}}</dt><dd>{{format-currency this.totals.subtotal this.currency}}</dd></div>
                    {{/if}}
                    {{#if this.totals.discount}}<div class="is-discount"><dt>{{t "storefront.orders.create.discount"}}{{#if this.appliedPromoCode}} {{this.appliedPromoCode}}{{/if}}</dt><dd>−{{format-currency this.totals.discount this.currency}}</dd></div>{{/if}}
                    {{#unless this.isPickup}}<div><dt>{{if this.isBooking (if this.travelDistance (t "storefront.orders.booking.travel-fee-km" distance=this.travelDistance) (t "storefront.orders.booking.travel-fee")) (t "storefront.orders.create.delivery-fee")}}</dt><dd>{{#if this.quote}}{{format-currency this.totals.delivery_fee this.currency}}{{else}}—{{/if}}</dd></div>{{/unless}}
                    {{#if this.totals.tip}}<div><dt>{{t "storefront.orders.create.tip"}}</dt><dd>{{format-currency this.totals.tip this.currency}}</dd></div>{{/if}}
                    <div class="is-total"><dt>{{t "storefront.networks.orders.columns.total"}}</dt><dd>{{format-currency this.totals.total this.currency}}</dd></div>
                </dl>
                <div class="storefront-create-order__status">
                    {{#if this.requote.isRunning}}
                        <Spinner @loadingMessage={{t "storefront.orders.create.pricing"}} />
                    {{else if this.issues.length}}
                        {{#each this.issues as |issue|}}<div class="storefront-create-order__issue"><FaIcon @icon="triangle-exclamation" @size="xs" class="mr-1" />{{issue}}</div>{{/each}}
                    {{else if this.quote}}
                        <div class="storefront-create-order__ok"><FaIcon @icon="check" @size="xs" class="mr-1" />{{#if this.minimum.required}}{{t "storefront.orders.create.minimum-met" amount=(format-currency this.minimum.amount this.currency)}}{{else}}{{t "storefront.orders.create.ready"}}{{/if}}</div>
                    {{/if}}
                </div>
            </section>

            <div class="storefront-create-order__footer">
                <Button @type="primary" @size="md" @icon="check" @text={{if this.isBooking this.bookLabel (t "storefront.orders.create.place" total=(format-currency this.totals.total this.currency))}} @disabled={{not this.canPlace}} @isLoading={{this.place.isRunning}} @onClick={{perform this.place}} @permission="storefront create order" class="w-full" @wrapperClass="w-full" data-test-place-order />
            </div>
        </aside>
    </Overlay::Body>
</Overlay>
