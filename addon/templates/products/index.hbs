<Storefront::PageHeader @title={{t "storefront.sidebar.products"}} @subtitle={{this.headerMeta}} @searchQuery={{this.query}} @onSearch={{perform this.search}} @searchPlaceholder={{t "storefront.products.index.search"}} data-test-products-header>
    <Storefront::ViewToggle @options={{array (hash id="grid" icon="th-large" title=(t "storefront.products.index.view-grid")) (hash id="list" icon="list" title=(t "storefront.products.index.view-list"))}} @value={{this.viewMode}} @onChange={{this.setViewMode}} @label={{t "storefront.common.view"}} />
    {{#if this.category}}
        <DropdownButton @icon="gear" @text={{t "storefront.products.index.category.category"}} @type="default" @size="sm" @renderInPlace={{false}} as |dd|>
            <div class="next-dd-menu mt-1 mx-0">
                <div class="px-1">
                    <a href="javascript:;" class="next-dd-item" disabled={{cannot "storefront update product-category"}} {{on "click" (dropdown-fn dd this.activeProductsController.editCategory this.category)}}>{{t "storefront.products.index.edit-category"}}</a>
                </div>
                <div class="px-1">
                    <a href="javascript:;" class="text-red-500 next-dd-item" disabled={{cannot "storefront delete product-category"}} {{on "click" (dropdown-fn dd this.activeProductsController.deleteCategory)}}>{{t "storefront.products.index.delete-category"}}</a>
                </div>
            </div>
        </DropdownButton>
    {{/if}}
    <Button @size="sm" @icon="tags" @text={{t "storefront.products.index.manage-addons"}} @permission="storefront list product-addon" @onClick={{this.manageAddons}} />
    <Button @size="sm" @icon="file-import" @text={{t "storefront.common.import"}} @permission="storefront import product" @onClick={{this.importProducts}} />
    <Button @type="primary" @size="sm" @icon="plus" @iconPrefix="fas" @text={{t "storefront.products.index.new-product"}} @onClick={{this.createNewProduct}} @permission="storefront create product" data-test-new-product />
</Storefront::PageHeader>

<Layout::Section::Body class="section-content storefront-products-page">
    <Storefront::Product::CategorySidebar
        @categories={{@model}}
        @activeCategory={{this.category}}
        @onCreate={{this.createNewProductCategory}}
        @onCreateSubcategory={{this.createProductSubcategory}}
        @onViewAll={{this.viewAllProducts}}
        @onSelect={{this.switchCategory}}
        @counts={{this.categoryCounts}}
        @summary={{this.summary}}
        @activeGroup={{this.activeGroup}}
        @onSelectGroup={{this.selectGroup}}
    />

    <div id="productsViewPort" class="storefront-products-viewport">
        <div class="storefront-products-toolbar">
            <div class="storefront-status-tabs" role="tablist" data-test-product-status-tabs>
                {{#each this.statusTabs as |tab|}}
                    <button type="button" role="tab" aria-selected={{if tab.isActive "true" "false"}} class="storefront-status-tab {{if tab.isActive 'is-active'}}" {{on "click" (fn this.selectStatusTab tab)}} data-test-status-tab={{tab.id}}>
                        <span>{{tab.label}}</span>
                        {{#if tab.count}}<span class="storefront-status-tab__count">{{tab.count}}</span>{{/if}}
                    </button>
                {{/each}}
            </div>
            <DropdownButton @text={{this.sortLabel}} @icon="arrow-down-wide-short" @size="xs" @buttonClass="storefront-products-sort" @contentClass="dropdown-menu" @renderInPlace={{true}} data-test-products-sort as |dd|>
                <div class="next-dd-menu mt-1 mx-0">
                    {{#each this.sortOptions as |option|}}
                        <div class="px-1">
                            <a href="#" class="next-dd-item {{if option.isActive 'is-active'}}" {{on "click" (dropdown-fn dd this.setSort option.value)}}>{{option.label}}</a>
                        </div>
                    {{/each}}
                </div>
            </DropdownButton>
        </div>
        {{#if this.hasSelection}}
            <div class="storefront-table-card__bulk storefront-products-bulk" data-test-product-bulk-bar>
                <span class="storefront-bulk-bar__count">{{t "storefront.networks.invitations.selected-count" count=this.selected.length}}</span>
                <Button @size="xs" @icon="eye" @text={{t "storefront.products.bulk.publish"}} @onClick={{this.bulkPublish}} @permission="storefront update product" />
                <Button @size="xs" @icon="eye-slash" @text={{t "storefront.products.bulk.unpublish"}} @onClick={{this.bulkUnpublish}} @permission="storefront update product" />
                <Button @size="xs" @icon="folder-tree" @text={{t "storefront.products.bulk.move"}} @onClick={{this.bulkMoveToCategory}} @permission="storefront update product" />
                <Button @size="xs" @icon="book-open" @text={{t "storefront.products.bulk.add-to-catalog"}} @onClick={{this.bulkAddToCatalog}} @permission="storefront update catalog" data-test-bulk-add-to-catalog />
                <Button @size="xs" @icon="percent" @text={{t "storefront.products.bulk.mark-on-sale"}} @onClick={{this.bulkMarkOnSale}} @permission="storefront update product" />
                <Button @size="xs" @type="danger" @icon="trash" @text={{t "common.delete"}} @onClick={{this.bulkDelete}} @permission="storefront delete product" />
                <a href="javascript:;" class="storefront-table-card__bulk-clear" {{on "click" this.clearSelection}}>{{t "storefront.networks.invitations.clear"}}</a>
            </div>
        {{/if}}
        {{outlet}}
    </div>
</Layout::Section::Body>

{{#if this.addonsPanelOpen}}
    <Storefront::Product::AddonsPanel @store={{this.activeStore}} @onClose={{this.closeAddons}} />
{{/if}}
