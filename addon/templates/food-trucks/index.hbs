<Layout::Section::Header @title={{t "storefront.common.food-trucks"}} @searchQuery={{this.query}} @onSearch={{perform this.search}}>
    <Button @type="primary" @icon="plus" @text={{t "storefront.common.new"}} @onClick={{this.createFoodTruck}} @permission="storefront create food-truck" class="mr-2" />
    <Button @icon="long-arrow-up" @iconClass="rotate-icon-45" @text={{t "storefront.common.export"}} @permission="storefront export food-truck" />
</Layout::Section::Header>

<Layout::Section::Body class="overflow-y-scroll-i h-full">
    <Layout::Resource::CardsGrid
        @resource="truck"
        @data={{@model}}
        @columns="4"
        @containerClass="p-4"
        @emptyStateText={{t "storefront.trucks.index.empty-state"}}
        @createButtonText={{t "storefront.trucks.index.create-truck"}}
        @onCreateNew={{this.createFoodTruck}}
        class="h-full"
        as |Item|
    >
        <Storefront::Truck::Card @truck={{Item.model}} @onEdit={{this.editFoodTruck}} @onAssignCatalogs={{this.assignCatalogs}} @onDelete={{this.deleteFoodTruck}} />
    </Layout::Resource::CardsGrid>
</Layout::Section::Body>

{{outlet}}
