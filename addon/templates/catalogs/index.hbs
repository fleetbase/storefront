{{#if this.isEditing}}
    {{outlet}}
{{else}}
    <Layout::Section::Header @title={{t "storefront.common.catalogs"}} @searchQuery={{this.query}} @onSearch={{perform this.search}}>
        <Button @type="primary" @icon="plus" @text={{t "storefront.common.new"}} @permission="storefront create catalog" @onClick={{this.createCatalog}} class="mr-2" />
        <Button @icon="long-arrow-up" @iconClass="rotate-icon-45" @text={{t "storefront.common.export"}} @permission="storefront export catalog" />
    </Layout::Section::Header>

    <Layout::Section::Body class="overflow-y-scroll-i h-full">
        <Layout::Resource::CardsGrid
            @resource="catalog"
            @data={{@model}}
            @columns="4"
            @containerClass="p-4"
            @emptyStateText={{t "storefront.catalogs.index.empty-state"}}
            @createButtonText={{t "storefront.catalogs.index.create-catalog"}}
            @onCreateNew={{this.createCatalog}}
            class="h-full"
            as |Item|
        >
            <Storefront::Catalog::Card @catalog={{Item.model}} @onEdit={{this.editCatalog}} @onDelete={{this.deleteCatalog}} />
        </Layout::Resource::CardsGrid>
    </Layout::Section::Body>

    {{outlet}}
{{/if}}
