{
    "name": "fleetbase/storefront-api",
    "version": "0.4.31",
    "description": "Headless Commerce & Marketplace Extension for Fleetbase",
    "keywords": [
        "fleetbase-extension",
        "storefront",
        "headless commerce",
        "marketplace",
        "e-commerce"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Fleetbase Pte Ltd.",
            "email": "hello@fleetbase.io"
        },
        {
            "name": "Ronald A. Richardson",
            "email": "ron@fleetbase.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "fleetbase/core-api": "^2.0",
        "fleetbase/fleetops-api": "^0.7.0",
        "geocoder-php/google-maps-places-provider": "^1.4",
        "laravel-notification-channels/apn": "^5.5",
        "laravel-notification-channels/fcm": "^5.1",
        "laravel-notification-channels/twilio": "^4.1",
        "milon/barcode": "^13.0",
        "php-http/guzzle7-adapter": "^1.0",
        "psr/http-factory-implementation": "*",
        "stripe/stripe-php": "^17.0",
        "toin0u/geocoder-laravel": "^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.34.1",
        "illuminate/validation": "^12.69",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^2.0",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Fleetbase\\Storefront\\": "server/src/",
            "Fleetbase\\Storefront\\Seeders\\": "server/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fleetbase\\Storefront\\Tests\\": "server/tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Fleetbase\\Storefront\\Providers\\StorefrontServiceProvider",
                "Fleetbase\\Storefront\\Providers\\EventServiceProvider"
            ]
        },
        "fleetbase": {
            "create-database": "storefront",
            "order-config": "Fleetbase\\Storefront\\Support\\OrderConfig",
            "sandbox-migrations": false
        }
    },
    "config": {
        "vendor-dir": "./server_vendor",
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-zwc5-qtrz-zm1n": {
                        "on-audit": false,
                        "reason": "CVE-2026-48019 has no patched illuminate/mail 9.x or 10.x release, and fleetbase/core-api requires ^9.0|^10.0. This only stops the install block; composer audit still reports it. Remove when core-api moves to Laravel 12.60 or later."
                    }
                }
            }
        }
    },
    "scripts": {
        "coverage:baseline": [
            "@test:coverage:clover",
            "@coverage:summary"
        ],
        "coverage:summary": "php scripts/coverage-summary.php coverage/clover.xml",
        "lint": "php-cs-fixer fix -v",
        "test:lint": "php-cs-fixer fix -v --dry-run",
        "test:coverage": "php scripts/coverage-runner.php --coverage --coverage-text --colors=always",
        "test:coverage:clover": "mkdir -p coverage && php scripts/coverage-runner.php --coverage-clover=coverage/clover.xml --colors=always",
        "test:types": "phpstan analyse --ansi --memory-limit=0",
        "test:unit": "php scripts/pest-runner.php --colors=always server/tests",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
